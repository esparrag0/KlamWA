<div class="sidebar-brand">
    <a href="@($"/inicio/{Perfil.Clave}")" aria-label="Klam, ir al inicio"><img src="img/klam-wordmark-blanco.svg" alt="Klam" /></a>
    <button class="mobile-toggle" type="button" aria-label="Abrir o cerrar menú" aria-controls="menu-principal" aria-expanded="@abierto.ToString().ToLowerInvariant()" @onclick="() => abierto = !abierto"><Icono Nombre="menu" /></button>
</div>
<div id="menu-principal" class="sidebar-body @(abierto ? "is-open" : "")">
    <nav aria-label="Navegación principal" @onclick="() => abierto = false">
        <div class="nav-section">Principal</div>
        <NavLink class="nav-link" href="/inicio"><Icono Nombre="inicio" /> Inicio</NavLink>
        @if (Perfil.Clave is "administrador" or "instrumentista")
        {
            <NavLink class="nav-link" href="/notificaciones"><Icono Nombre="campana" /> Notificaciones <span class="nav-count">2</span></NavLink>
        }
        <div class="nav-section">Agenda y cirugías</div>
        <NavLink class="nav-link" href="/agenda" Match="NavLinkMatch.All"><Icono Nombre="calendario" /> Calendario</NavLink>
        <NavLink class="nav-link" href="/agenda/lista"><Icono Nombre="lista" /> Lista de cirugías</NavLink>
        @if (Perfil.Clave is "administrador" or "vendedor")
        {
            <NavLink class="nav-link" href="/agenda/nueva"><Icono Nombre="mas" /> Nueva cirugía</NavLink>
        }
        <NavLink class="nav-link" href="/agenda/historial"><Icono Nombre="reloj" /> Historial</NavLink>
        @if (Perfil.Clave == "administrador")
        {
            <div class="nav-section">Administración</div>
            <NavLink class="nav-link" href="/usuarios"><Icono Nombre="usuarios" /> Usuarios</NavLink>
            <NavLink class="nav-link" href="/roles"><Icono Nombre="escudo" /> Roles y responsabilidades</NavLink>
        }
    </nav>
    <div class="sidebar-bottom"><a class="exit-link" href="/login"><Icono Nombre="salir" Tamano="18" /> Volver al acceso</a></div>
</div>

@code {
    [Parameter, EditorRequired] public PerfilVista Perfil { get; set; } = DatosAcceso.Perfiles[0];
    private bool abierto;
}
