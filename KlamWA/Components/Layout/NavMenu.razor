<div class="sidebar-brand">
    <a href="@($"/inicio/{Perfil.Clave}")" aria-label="Klam, ir al inicio"><img src="img/klam-wordmark-blanco.svg" alt="Klam" /></a>
    <button class="mobile-toggle" type="button" aria-label="Abrir o cerrar menú" aria-controls="menu-principal" aria-expanded="@abierto.ToString().ToLowerInvariant()" @onclick="() => abierto = !abierto"><Icono Nombre="menu" /></button>
</div>
<div id="menu-principal" class="sidebar-body @(abierto ? "is-open" : "")">
    <nav aria-label="Navegación principal" @onclick="() => abierto = false">
        <div class="nav-section">Principal</div>
        <NavLink class="nav-link" href="/inicio"><Icono Nombre="inicio" /> Inicio</NavLink>
        @if (Perfil.Clave is "administrador" or "instrumentista")
        {
            <NavLink class="nav-link" href="/notificaciones"><Icono Nombre="campana" /> Notificaciones <span class="nav-count">2</span></NavLink>
        }
        <div class="nav-section">Agenda y cirugías</div>
        @if (Perfil.Clave is "administrador" or "instrumentista") { <NavLink class="nav-link" href="/agenda" Match="NavLinkMatch.All"><Icono Nombre="calendario" /> Calendario</NavLink> }
        <NavLink class="nav-link" href="/agenda/lista"><Icono Nombre="lista" /> @(Perfil.Clave == "vendedor" ? "Cirugías que coordino" : Perfil.Clave == "instrumentista" ? "Mis cirugías" : "Lista de cirugías")</NavLink>
        @if (Perfil.Clave == "administrador")
        {
            <NavLink class="nav-link" href="/agenda/nueva"><Icono Nombre="mas" /> Nueva cirugía</NavLink>
        }
        @if (Perfil.Clave == "administrador") { <NavLink class="nav-link" href="/agenda/historial"><Icono Nombre="reloj" /> Historial</NavLink> }
        @if (Perfil.Clave == "administrador")
        {
            <div class="nav-section">Administración</div>
            <NavLink class="nav-link" href="/usuarios"><Icono Nombre="usuarios" /> Usuarios</NavLink>
            <NavLink class="nav-link" href="/roles"><Icono Nombre="escudo" /> Roles y responsabilidades</NavLink>
        }
        @if (Perfil.Clave == "administrador")
        {
            <div class="nav-section">Cotizaciones</div>
            <NavLink class="nav-link" href="/cotizaciones" Match="NavLinkMatch.All"><Icono Nombre="lista" /> Cotizaciones</NavLink>
            <div class="nav-section">Reportes</div>
            <NavLink class="nav-link" href="/reportes/consumo"><Icono Nombre="lista" /> Uso de insumos</NavLink>
            <NavLink class="nav-link" href="/reportes/comparativo"><Icono Nombre="flecha" /> Despacho y consumo</NavLink>
        }
        @if (Perfil.Clave == "cliente")
        {
            <div class="nav-section">Cotizaciones</div>
            <NavLink class="nav-link" href="/cotizaciones/cliente"><Icono Nombre="lista" /> Mis cotizaciones</NavLink>
        }
        @if (Perfil.Clave == "administrador")
        {
            <div class="nav-section">Documentación</div>
            <NavLink class="nav-link" href="/solicitudes"><Icono Nombre="lista" /> Revisar solicitudes</NavLink>
            <NavLink class="nav-link" href="/historial-documental"><Icono Nombre="reloj" /> Historial documental</NavLink>
        }
        @if (Perfil.Clave == "administrador") { <NavLink class="nav-link" href="/bitacora-cirugias"><Icono Nombre="reloj" /> Bitácora de cirugías</NavLink> }
        @if (Perfil.Clave == "administrador")
        {
            <div class="nav-section">Inventario y logística</div>
            <NavLink class="nav-link" href="/inventario/despachos"><Icono Nombre="flecha" /> Despachos y retornos</NavLink>
            <NavLink class="nav-link" href="/inventario/consumos"><Icono Nombre="lista" /> Consumos</NavLink>
        }
        @if (Perfil.Clave == "administrador")
        {
            <div class="nav-section">Clientes</div>
            <NavLink class="nav-link" href="/clientes" Match="NavLinkMatch.All"><Icono Nombre="usuarios" /> Lista de clientes</NavLink>
            <NavLink class="nav-link" href="/clientes/nuevo"><Icono Nombre="mas" /> Nuevo cliente</NavLink>
        }
        @if (Perfil.Clave is "cliente" or "vendedor")
        {
            <div class="nav-section">Solicitudes de cirugía</div>
            <NavLink class="nav-link" href="/mis-solicitudes" Match="NavLinkMatch.All"><Icono Nombre="lista" /> Mis solicitudes</NavLink>
            <NavLink class="nav-link" href="/mis-solicitudes/nueva"><Icono Nombre="mas" /> Nueva solicitud</NavLink>
        }
    </nav>
    <div class="sidebar-bottom"><a class="exit-link" href="/login"><Icono Nombre="salir" Tamano="18" /> Volver al acceso</a></div>
</div>

@code {
    [Parameter, EditorRequired] public PerfilVista Perfil { get; set; } = DatosAcceso.Perfiles[0];
    private bool abierto;
}
