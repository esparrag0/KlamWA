@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject KlamWA.Servicios.AvisosSinLeer Avisos
@inject VistaPreviaRol Vista
@inject NavigationManager Nav

<a class="skip-link" href="#contenido">Saltar al contenido</a>
<div class="app-shell">
    <aside class="app-sidebar"><NavMenu Perfil="Vista.Perfil" /></aside>
    <div class="app-main">
        <header class="app-topbar">
            <a class="topbar-brand" href="/inicio">BIOKLAM</a>
            <div class="topbar-actions">
                @if (TieneBandeja)
                {
                    <a class="header-bell" href="/notificaciones" aria-label="@($"Ver notificaciones, {Avisos.Cantidad ?? 0} sin leer")">
                        <Icono Nombre="campana" Tamano="20" />@if (Avisos.Cantidad > 0) { <span class="notification-count">@Avisos.Cantidad</span> }
                    </a>
                }
                <details class="profile-menu">
                    <summary aria-label="Opciones de la cuenta"><span class="avatar avatar-sm">@Vista.Perfil.Iniciales</span><span class="profile-name">@Vista.Perfil.Persona</span><span class="profile-chevron" aria-hidden="true"></span></summary>
                    <div class="profile-dropdown">
                        <span class="profile-caption">Cuenta de @Vista.Perfil.Persona</span>
                        <a href="/cuenta/password"><Icono Nombre="usuarios" Tamano="17" /> Cambiar contraseña</a>
                        <form method="post" action="/cuenta/logout"><AntiforgeryToken /><button type="submit"><Icono Nombre="salir" Tamano="17" /> Cerrar sesión</button></form>
                    </div>
                </details>
            </div>
        </header>
        <main id="contenido" class="app-content" tabindex="-1">
            @if (PaginaPermitida) { @Body }
            else
            {
                <EstadoVacio Titulo="Pantalla no disponible en este perfil" Descripcion="Usa las opciones del menú correspondientes a tu cuenta." />
                <a class="btn btn-outline-primary" href="/inicio">Volver al inicio</a>
            }
        </main>
    </div>
</div>
<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error al mostrar la página. <a href="." class="reload">Recargar</a>
    <button type="button" class="dismiss" aria-label="Cerrar mensaje">×</button>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private bool PaginaPermitida
    {
        get
        {
            var ruta = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            bool Es(string prefijo) => ruta == prefijo || ruta.StartsWith(prefijo + "/", StringComparison.OrdinalIgnoreCase);
            if (ruta.StartsWith("/inicio/", StringComparison.OrdinalIgnoreCase))
                return ruta.Equals($"/inicio/{Vista.Perfil.Clave}", StringComparison.OrdinalIgnoreCase);
            if (Es("/notificaciones"))
            {
                if (!TieneBandeja) return false;
                // El backend solo entrega los avisos propios de la sesión (los ajenos responden 403).
                if (ruta.StartsWith("/notificaciones/detalle/", StringComparison.OrdinalIgnoreCase))
                    return int.TryParse(ruta["/notificaciones/detalle/".Length..], out _);
                return ruta == "/notificaciones"
                    || ruta.Equals($"/notificaciones/{Vista.Perfil.Clave}", StringComparison.OrdinalIgnoreCase);
            }
            if (ruta.Contains("/orden-compra", StringComparison.OrdinalIgnoreCase))
                return Vista.Perfil.Clave is "cliente" or "administrador";
            if (ruta.Contains("/revisar-oc", StringComparison.OrdinalIgnoreCase) || ruta.Contains("/rechazar-oc", StringComparison.OrdinalIgnoreCase))
                return Vista.Perfil.Clave == "administrador";
            if (ruta == "/agenda") return Vista.Perfil.Clave is "administrador" or "instrumentista";
            if (Es("/agenda/historial")) return Vista.Perfil.Clave is "administrador" or "cliente";
            if (Es("/agenda/nueva") || Es("/agenda/registrar") || Es("/agenda/editar") || Es("/agenda/eliminar")
                || Es("/bitacora-cirugias") || Es("/historial-documental") || Es("/usuarios")
                || Es("/clientes") || Es("/solicitudes") || Es("/reportes") || Es("/inventario"))
                return Vista.Perfil.Clave == "administrador";
            if (Es("/mis-solicitudes/corregir")) return Vista.Perfil.Clave is "administrador" or "vendedor";
            if (Es("/mis-solicitudes")) return Vista.Perfil.Clave is "cliente" or "vendedor";
            if (ruta == "/cotizaciones") return Vista.Perfil.Clave == "administrador";
            if (Es("/cotizaciones/cliente")) return Vista.Perfil.Clave == "cliente";
            if (Es("/cotizaciones/documento")) return Vista.Perfil.Clave is "administrador" or "cliente";
            return true;
        }
    }

    // RF12: bandeja de avisos internos del personal (los clientes no reciben avisos).
    private bool TieneBandeja => Vista.Perfil.Clave is "administrador" or "instrumentista" or "vendedor";

    protected override async Task OnInitializedAsync()
    {
        Vista.Cambio += Actualizar;
        Avisos.Cambio += Actualizar;
        Vista.Establecer((await AuthenticationStateTask).User);
        if (TieneBandeja) await Avisos.ActualizarAsync();
    }

    private void Actualizar() => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Vista.Cambio -= Actualizar;
        Avisos.Cambio -= Actualizar;
    }
}
