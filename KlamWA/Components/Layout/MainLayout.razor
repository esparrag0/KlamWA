@inherits LayoutComponentBase
@implements IDisposable
@inject VistaPreviaRol Vista
@inject KlamWA.Services.SesionUsuario Sesion
@inject NavigationManager Nav

<a class="skip-link" href="#contenido">Saltar al contenido</a>
<div class="app-shell">
    <aside class="app-sidebar"><NavMenu Perfil="Vista.Perfil" /></aside>
    <div class="app-main">
        <header class="app-topbar">
            <a class="topbar-brand" href="/inicio">BIOKLAM</a>
            <div class="topbar-actions">
                @if (Vista.Perfil.Clave is "administrador" or "instrumentista")
                {
                    <a class="header-bell" href="@($"/notificaciones/{Vista.Perfil.Clave}")" aria-label="Ver notificaciones, 2 sin leer de ejemplo">
                        <Icono Nombre="campana" /><span class="notification-dot"></span>
                    </a>
                }
                <span class="small text-muted d-none d-md-inline">@Sesion.UserName · @Vista.Perfil.Nombre</span>
                <span class="avatar avatar-sm" aria-label="@Sesion.UserName">@Iniciales</span>
                <a class="btn btn-link btn-sm" href="/cuenta/password">Cambiar contraseña</a>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CerrarSesion">Cerrar sesión</button>
            </div>
        </header>
        <main id="contenido" class="app-content" tabindex="-1">
            @if (!verificada) { <p class="text-muted">Verificando sesión…</p> }
            else if (PaginaPermitida) { @Body }
            else
            {
                <EstadoVacio Titulo="Pantalla no disponible en este perfil" Descripcion="Usa las opciones del menú correspondientes a tu perfil." />
                <a class="btn btn-outline-primary" href="/inicio">Volver al inicio</a>
            }
        </main>
    </div>
</div>
<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error al mostrar la página. <a href="." class="reload">Recargar</a>
    <button type="button" class="dismiss" aria-label="Cerrar mensaje">×</button>
</div>

@code {
    // Restricción visual por perfil; no sustituye permisos del backend.
    private bool PaginaPermitida
    {
        get
        {
            var ruta = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            bool Es(string prefijo) => ruta == prefijo || ruta.StartsWith(prefijo + "/", StringComparison.OrdinalIgnoreCase);
            if (ruta.Contains("/orden-compra", StringComparison.OrdinalIgnoreCase))
                return Vista.Perfil.Clave is "cliente" or "administrador";
            if (ruta.Contains("/revisar-oc", StringComparison.OrdinalIgnoreCase) || ruta.Contains("/rechazar-oc", StringComparison.OrdinalIgnoreCase))
                return Vista.Perfil.Clave == "administrador";
            if (Es("/agenda/historial")) return Vista.Perfil.Clave is "administrador" or "cliente";
            if (Es("/agenda/nueva") || Es("/agenda/editar") || Es("/agenda/eliminar")
                || Es("/bitacora-cirugias") || Es("/historial-documental") || Es("/usuarios")
                || Es("/clientes") || Es("/solicitudes")
                || Es("/reportes") || Es("/inventario"))
                return Vista.Perfil.Clave == "administrador";
            if (Es("/mis-solicitudes")) return Vista.Perfil.Clave is "cliente" or "vendedor";
            if (ruta == "/cotizaciones") return Vista.Perfil.Clave == "administrador";
            if (Es("/cotizaciones/cliente")) return Vista.Perfil.Clave == "cliente";
            if (Es("/cotizaciones/documento")) return Vista.Perfil.Clave is "administrador" or "cliente";
            return true;
        }
    }
    private bool verificada;

    protected override void OnInitialized()
    {
        Vista.Cambio += Actualizar;
        if (Sesion.EstaAutenticado)   // navegación dentro del mismo circuito: no hace falta volver a verificar
        {
            verificada = true;
            if (DatosAcceso.Perfil(Sesion.ClavePerfil) is { } propio) Vista.Mostrar(propio);
        }
    }

    // Todas las pantallas (salvo /login) exigen sesión. Tras una recarga (F5) la sesión se recupera del
    // almacenamiento de la pestaña; si no hay ninguna, se vuelve al acceso. El perfil visible sale de la cuenta.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await Sesion.RestaurarAsync())
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }
        if (DatosAcceso.Perfil(Sesion.ClavePerfil) is { } propio) Vista.Mostrar(propio);
        verificada = true;
        StateHasChanged();
    }

    private string Iniciales => Sesion.UserName.Length >= 2 ? Sesion.UserName[..2].ToUpperInvariant() : Sesion.UserName.ToUpperInvariant();

    private void Actualizar() => _ = InvokeAsync(StateHasChanged);

    private async Task CerrarSesion()
    {
        await Sesion.CerrarAsync();
        Nav.NavigateTo("/login", forceLoad: true);   // circuito nuevo: no queda estado de la sesión anterior
    }

    public void Dispose() => Vista.Cambio -= Actualizar;
}
