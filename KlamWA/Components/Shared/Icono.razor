<svg class="klam-icon @Clase" width="@Tamano" height="@Tamano" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Nombre)
    {
        case "inicio": <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" /> break;
        case "usuarios": <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /><circle cx="9" cy="7" r="4" /> break;
        case "escudo": <path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6Z" /><path d="m8 12 3 3 5-6" /> break;
        case "campana": <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /> break;
        case "calendario": <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18m-14 4h2m3 0h2m3 0h1m-11 3h2" /> break;
        case "lista": <rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8M8 12h8M8 16h5" /> break;
        case "mas": <path d="M12 5v14M5 12h14" /> break;
        case "reloj": <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
        case "salir": <path d="M9 21H4V3h5m6 5 4 4-4 4m-7-4h11" /> break;
        case "flecha": <path d="M5 12h14m-5-5 5 5-5 5" /> break;
        case "volver": <path d="M19 12H5m5-5-5 5 5 5" /> break;
        case "buscar": <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /> break;
        case "editar": <path d="m15 4 5 5M4 20l5-1L21 7a2 2 0 0 0-4-4L5 15Zm9 0h8" /> break;
        case "eliminar": <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7" /> break;
        case "correo": <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /> break;
        case "check": <path d="m5 12 4 4L19 6" /> break;
        case "menu": <path d="M4 6h16M4 12h16M4 18h16" /> break;
        case "ojo": <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /> break;
        default: <circle cx="12" cy="12" r="9" /><path d="M12 11v6m0-10v.1" /> break;
    }
</svg>

@code {
    [Parameter] public string Nombre { get; set; } = "info";
    [Parameter] public int Tamano { get; set; } = 20;
    [Parameter] public string? Clase { get; set; }
}
