@* Espera. Dos formas, según lo que se esté esperando.

   Con Filas > 0 dibuja un esqueleto con la forma de la tabla que viene. Es el
   modo preferido en los listados: la página no da un salto cuando llegan los
   datos y la espera se hace más corta porque ya se ve la estructura.

   Con Filas = 0 es una línea con girador, para detalles y formularios donde no
   hay una forma que anticipar.

   El texto habla de lo que espera quien mira ("Consultando usuarios"), nunca
   de dónde se consulta: MySQL, el backend o Java no son asunto suyo. *@

@if (Filas > 0)
{
    <div class="cargando-esqueleto" role="status" aria-live="polite">
        <span class="visually-hidden">@Texto</span>
        @for (var fila = 0; fila < Filas; fila++)
        {
            <div class="esqueleto-fila" aria-hidden="true">
                @foreach (var ancho in Anchos[fila % Anchos.Length])
                {
                    <span class="esqueleto" style="width:@(ancho)%"></span>
                }
            </div>
        }
    </div>
}
else
{
    <p class="cargando-linea" role="status" aria-live="polite">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>@Texto
    </p>
}

@code {
    /// <summary>Qué se está esperando, en palabras de quien mira.</summary>
    [Parameter] public string Texto { get; set; } = "Cargando";

    /// <summary>Filas del esqueleto. 0 muestra la línea con girador.</summary>
    [Parameter] public int Filas { get; set; }

    // Anchos irregulares: un esqueleto con todas las barras iguales parece una
    // rejilla rota; desigual se lee como texto que aún no ha llegado.
    private static readonly int[][] Anchos =
    [
        [26, 20, 14, 10],
        [20, 26, 10, 14],
        [30, 16, 12, 12],
        [22, 22, 16, 10]
    ];
}
