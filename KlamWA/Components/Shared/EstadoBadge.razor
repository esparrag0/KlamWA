@using KlamWA.Components.Shared
<span class="badge estado-badge @(Grande ? "estado-badge-lg" : "")" style="background-color:@DatosAgenda.Color(Estado); color:@DatosAgenda.ColorTexto(Estado);">@Estado</span>

@code {
    [Parameter] public string Estado { get; set; } = "";
    [Parameter] public bool Grande { get; set; }   // para encabezados: junto al nombre de la cirugía
}
