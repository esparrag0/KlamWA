@* Etiqueta de estado de documentos y solicitudes con los colores del Design System:
   Pendiente / Por revisar (azul claro), Validado / Aprobada (turquesa), Rechazado / Rechazada (rosa claro).
   Acepta el código de Java (PENDIENTE, POR_REVISAR...) o el texto ya formateado. *@
<span class="badge estado-badge @Clase">@Texto</span>

@code {
    [Parameter] public string Estado { get; set; } = "";

    private string Texto => Estado switch
    {
        "PENDIENTE" => "Pendiente",
        "VALIDADO" => "Validado",
        "RECHAZADO" => "Rechazado",
        "POR_REVISAR" => "Por revisar",
        "DOCUMENTACION_INCOMPLETA" => "Documentación incompleta",
        "RECHAZADA" => "Rechazada",
        "APROBADA" => "Aprobada",
        _ => Estado
    };

    private string Clase => KlamWA.ViewModels.EstadoSolicitudTexto.Clase(Texto);
}
