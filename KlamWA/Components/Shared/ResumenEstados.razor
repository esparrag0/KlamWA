@using KlamWA.Components.Shared
@* Tarjetas con la cantidad de cirugías por estado; sirve también como leyenda de colores *@
<div class="row g-2 mb-3">
    @foreach (var estado in DatosAgenda.Estados)
    {
        <div class="col-6 col-md-3">
            <div class="card h-100" style="border-left:6px solid @DatosAgenda.Color(estado)">
                <div class="card-body py-2">
                    <div class="text-muted small">@estado</div>
                    <div class="fs-4 fw-semibold">@Cirugias.Count(c => c.Estado == estado)</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<CirugiaMock> Cirugias { get; set; } = new List<CirugiaMock>();
}
