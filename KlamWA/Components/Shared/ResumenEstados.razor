@* Tarjetas con la cantidad de cirugías por estado; sirven también como leyenda de colores *@
<div class="row g-2 mb-3">
    @foreach (var estado in Estados)
    {
        <div class="col-6 col-md-3">
            <div class="card h-100" style="border-left:6px solid @DatosAgenda.ColorTexto(estado); background-color:@DatosAgenda.Color(estado)">
                <div class="card-body py-2">
                    <div class="small" style="color:@DatosAgenda.ColorTexto(estado)">@estado</div>
                    <div class="fs-4 fw-semibold" style="color:@DatosAgenda.ColorTexto(estado)">@Cirugias.Count(c => c.Estado == estado)</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] Estados = { "Programada", "En curso", "Culminada", "Cancelada" };
    [Parameter] public IEnumerable<CirugiaResumenViewModel> Cirugias { get; set; } = new List<CirugiaResumenViewModel>();
}
