@* Confirmación para acciones críticas (cancelar, eliminar, cerrar un proceso) *@
@if (Visible)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" style="background-color: rgba(15, 23, 42, 0.45);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Titulo</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="OnCancelar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">@Mensaje</p>
                    @ChildContent
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="OnCancelar" disabled="@Procesando">Volver</button>
                    <button type="button" class="btn @ClaseConfirmar" @onclick="OnConfirmar" disabled="@Procesando">@TextoConfirmar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Titulo { get; set; } = "Confirmar acción";
    [Parameter] public string Mensaje { get; set; } = "";
    [Parameter] public string TextoConfirmar { get; set; } = "Confirmar";
    [Parameter] public string ClaseConfirmar { get; set; } = "btn-danger";
    [Parameter] public bool Procesando { get; set; }
    [Parameter] public EventCallback OnConfirmar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
