@page "/inventario/despachos"

<PageTitle>Despachos y retornos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="text-muted">Operaciones / Despachos y retornos</span>
        <h2 class="mt-2">Despachos y retornos</h2>
        <p class="text-muted">Control del equipo y kit enviados al establecimiento</p>
    </div>
</div>

<div class="row mb-4 align-items-end">
    <div class="col-md-8">
        <label class="form-label">Búsqueda</label>
        <input type="text" class="form-control" placeholder="Cirugía, cliente o equipo" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Retorno</label>
        <select class="form-select">
            <option>Pendientes de retorno</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>DESPACHO</th>
                <th>CIRUGÍA / DESTINO</th>
                <th>EQUIPO</th>
                <th>SALIDA</th>
                <th>RETORNO</th>
            </tr>
        </thead>
        <tbody>
            <tr style="cursor: pointer;" onclick="window.location.href='inventario/despachos/detalle/DSP-026'">
                <td>DSP-026</td>
                <td>CIR-026 · San Felipe</td>
                <td>CR-02 · BI-026</td>
                <td>26 oct · 06:30</td>
                <td><span class="text-warning">Pendiente</span></td>
            </tr>
            <tr>
                <td>DSP-027</td>
                <td>CIR-027 · Almenara</td>
                <td>NN-01 · BI-027</td>
                <td>26 oct · 07:00</td>
                <td><span class="text-warning">Pendiente</span></td>
            </tr>
            <tr>
                <td>DSP-024</td>
                <td>CIR-024 · San Felipe</td>
                <td>CR-03 · BI-024</td>
                <td>22 oct · 12:00</td>
                <td><span class="text-success">Registrado</span></td>
            </tr>
        </tbody>
    </table>
</div>