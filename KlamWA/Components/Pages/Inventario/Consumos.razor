@page "/inventario/consumos"
@using KlamWA.Servicios
@inject IConsumoService ConsumoService

<PageTitle>Consumo por cirugía</PageTitle>

<PageHeader Titulo="Consumo por cirugía"
            Subtitulo="Se habilita cuando la documentación de cierre de una cirugía culminada está validada" />

@if (mensajeError != null)
{
    <Aviso Tipo="@tonoMensaje" Mensaje="@mensajeError" AlCerrar="() => mensajeError = null" />
}

<div class="row g-2 mb-3">
    <div class="col-md-4"><label for="consumo-buscar" class="form-label">Cirugía o cliente</label><input id="consumo-buscar" class="form-control" placeholder="CIR-001 o nombre" value="@busqueda" @oninput="OnBusquedaChanged" /></div>
    <div class="col-md-3"><label for="consumo-desde" class="form-label">Desde</label><input id="consumo-desde" type="date" class="form-control" value="@DesdeTexto" @onchange="OnDesdeChanged" /></div>
    <div class="col-md-3"><label for="consumo-hasta" class="form-label">Hasta</label><input id="consumo-hasta" type="date" class="form-control" value="@HastaTexto" @onchange="OnHastaChanged" /></div>
</div>

@if (cargando)
{
    <div class="card"><Espera Texto="Consultando consumos" Filas="4" /></div>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>CIRUGÍA</th>
                    <th>CLIENTE</th>
                    <th>FECHA</th>
                    <th>DOCUMENTACIÓN DE CIERRE</th>
                    <th>REGISTRO DE CONSUMO</th>
                    <th class="text-start text-nowrap pe-0" style="width: 1%">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr class="@(fila.PuedeRegistrarConsumo ? "table-active" : null)">
                        <td>
                            @fila.Codigo
                            @if (!string.IsNullOrWhiteSpace(fila.Procedimiento))
                            {
                                <div class="text-muted small">@fila.Procedimiento</div>
                            }
                        </td>
                        <td>
                            @fila.Cliente
                            <div class="text-muted small">@(fila.EsClinica ? "Orden de compra" : "Paciente particular")</div>
                        </td>
                        <td>@(fila.Inicio?.ToString("dd MMM") ?? "—")</td>
                        @* El cierre documental es cosa de clínicas y hospitales: son los
                           únicos que compran a crédito y emiten orden de compra. Para un
                           particular, que paga por adelantado, estas tres columnas no
                           aplican y se marcan con un guion. *@
                        @if (!fila.EsClinica)
                        {
                            <td class="text-muted">—</td>
                            <td class="text-muted">—</td>
                            <td class="text-start text-nowrap pe-0 text-muted">—</td>
                        }
                        else
                        {
                            <td><DocumentoEstadoBadge Estado="@fila.DocumentacionTexto" /></td>
                            <td><DocumentoEstadoBadge Estado="@fila.EstadoConsumoTexto" /></td>
                            <td class="text-start text-nowrap pe-0">
                                @if (fila.PuedeRegistrarConsumo)
                                {
                                    <a href="/inventario/consumos/registrar/@fila.IdCirugia" class="btn btn-sm btn-accion btn-primary">Registrar consumo</a>
                                }
                                else if (fila.PuedeVerComparativo)
                                {
                                    <a href="/reportes/comparativo/@fila.IdCirugia" class="btn btn-sm btn-accion btn-outline-primary">Ver comparativo</a>
                                }
                                else if (fila.PuedeRevisarOc)
                                {
                                    <a href="/agenda/cirugia/@fila.IdCirugia/revisar-oc" class="btn btn-sm btn-accion btn-outline-primary">Revisar OC</a>
                                }
                                else
                                {
                                    <a href="/agenda/cirugia/@fila.IdCirugia" class="btn btn-sm btn-accion btn-outline-secondary">Ver cirugía</a>
                                }
                            </td>
                        }
                    </tr>
                }
                @if (!filas.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay cirugías culminadas para este filtro.</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string busqueda = "";
    private DateTime? desde;
    private DateTime? hasta;
    private bool cargando = true;
    private string? mensajeError;
    private TipoAviso tonoMensaje = TipoAviso.Error;
    private List<ConsumoCirugiaViewModel> filas = [];

    private string? DesdeTexto => desde?.ToString("yyyy-MM-dd");
    private string? HastaTexto => hasta?.ToString("yyyy-MM-dd");

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task OnBusquedaChanged(ChangeEventArgs e)
    {
        busqueda = e.Value?.ToString() ?? "";
        await Cargar();
    }

    private async Task OnDesdeChanged(ChangeEventArgs e)
    {
        desde = ParsearFecha(e.Value?.ToString());
        await Cargar();
    }

    private async Task OnHastaChanged(ChangeEventArgs e)
    {
        hasta = ParsearFecha(e.Value?.ToString());
        await Cargar();
    }

    private static DateTime? ParsearFecha(string? texto) =>
        DateTime.TryParse(texto, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var fecha) ? fecha : null;

    private async Task Cargar()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            filas = await ConsumoService.ListarAsync(busqueda, desde, hasta);
        }
        catch (Exception ex)
        {
            filas = [];
            tonoMensaje = MensajeDeError.Tono(ex);
            mensajeError = "No se pudieron obtener los consumos: " + MensajeDeError.Texto(ex);
        }
        finally
        {
            cargando = false;
        }
    }
}
