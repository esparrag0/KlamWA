@page "/notificaciones"
@page "/notificaciones/{Rol}"
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject INotificacionService NotificacionService
@inject VistaPreviaRol Vista
@inject AvisosSinLeer Contador

<PageTitle>Notificaciones | Klam</PageTitle>
<div class="breadcrumb-line">Espacio de trabajo <span>/</span> Notificaciones</div>
<PageHeader Titulo="Notificaciones" Subtitulo="Mantente al tanto de las solicitudes y la programación quirúrgica.">
    @if (avisos.Any(a => !a.Leida))
    {
        <button type="button" class="btn btn-outline-secondary" @onclick="MarcarTodasLeidas" disabled="@procesando">
            <Icono Nombre="check" Tamano="17" /> Marcar todas como leídas
        </button>
    }
</PageHeader>

<nav class="view-tabs" aria-label="Bandeja de notificaciones"><a href="/notificaciones" class="active">Mi bandeja</a></nav>

@if (mensajeOk != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeOk
        <button type="button" class="btn-close" aria-label="Close" @onclick="() => mensajeOk = null"></button>
    </div>
}
@if (mensajeError != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" aria-label="Close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (desconocido)
{
    <EstadoVacio Titulo="Bandeja no disponible" Descripcion="Esta ruta no corresponde a tu bandeja de notificaciones." Enlace="/notificaciones" TextoEnlace="Ir a mi bandeja" />
}
else if (errorCarga)
{
    @* Si no se pudo cargar, no se muestra «Estás al día»: no sabemos si hay avisos. *@
    <div class="card p-4 text-center">
        <p class="text-muted mb-3">No se pudo mostrar tu bandeja en este momento.</p>
        <div><button type="button" class="btn btn-outline-primary" @onclick="CargarNotificaciones">Reintentar</button></div>
    </div>
}
else if (vacia || (!cargando && avisos.Count == 0))
{
    <EstadoVacio Icono="campana" Titulo="Estás al día" Descripcion="Cuando haya nuevas notificaciones, las encontrarás en este espacio." Enlace="/notificaciones" TextoEnlace="Volver a la bandeja" />
}
else if (cargando)
{
    <div class="card p-4 text-center text-muted">Cargando notificaciones...</div>
}
else
{
    var sinLeer = avisos.Count(a => !a.Leida);
    <div class="row g-4">
        <div class="col-xl-8">
            <section class="card">
                <div class="section-heading">
                    <h2>Bandeja de @perfil <span class="count-label">@avisos.Count</span></h2>
                    @if (sinLeer > 0)
                    {
                        <EtiquetaEstado Texto="@($"{sinLeer} sin leer")" Tono="teal" />
                    }
                    else
                    {
                        <EtiquetaEstado Texto="Al día" Tono="neutral" />
                    }
                </div>
                @foreach (var n in avisos)
                {
                    <article class="notification-row @(n.Leida ? "" : "is-unread")">
                        <span class="notification-symbol">
                            <Icono Nombre="@(n.Categoria.Contains("cirugía", StringComparison.OrdinalIgnoreCase) ? "calendario" : (perfil == "administrador" ? "lista" : "calendario"))" Tamano="23" />
                        </span>
                        <div class="notification-content">
                            <div class="notification-meta">
                                <span>@n.Categoria</span>
                                <time>@n.FechaTexto</time>
                            </div>
                            <h2><a href="@($"/notificaciones/detalle/{n.Id}")">@n.Titulo</a></h2>
                            <p>@n.Mensaje</p>
                            <div class="notification-bottom">
                                <EtiquetaEstado Texto="@(n.Leida ? "Leída" : "Sin leer")" Tono="@(n.Leida ? "neutral" : "teal")" />
                                <div class="d-flex align-items-center gap-2">
                                    @if (!n.Leida)
                                    {
                                        <button class="btn btn-sm btn-link text-decoration-none p-0" @onclick="() => MarcarLeida(n.Id)" disabled="@procesando">
                                            Marcar leída
                                        </button>
                                        <span class="text-muted">·</span>
                                    }
                                    <a href="@($"/notificaciones/detalle/{n.Id}")">Ver detalle <Icono Nombre="flecha" Tamano="15" /></a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
                <div class="table-footer">
                    <span>@avisos.Count notificaciones</span>
                    <span>@DateTime.Now.ToString("MMMM yyyy")</span>
                </div>
            </section>
        </div>
        <div class="col-xl-4">
            <aside class="card notification-aside">
                <span class="stat-icon"><Icono Nombre="campana" Tamano="24" /></span>
                <h2>Tus canales de aviso</h2>
                <p>@(perfil == "administrador" ? "Las nuevas solicitudes se presentan en el panel y en una vista de correo." : "Las nuevas cirugías se presentan en el panel de coordinación.")</p>
                <div class="channel-row">
                    <Icono Nombre="campana" Tamano="18" />
                    <span>Panel de notificaciones</span>
                    <EtiquetaEstado Texto="Activo" Tono="teal" />
                </div>
                @if (perfil == "administrador")
                {
                    <div class="channel-row">
                        <Icono Nombre="correo" Tamano="18" />
                        <span>Correo electrónico</span>
                        <EtiquetaEstado Texto="Informativo" Tono="neutral" />
                    </div>
                }
                <p class="field-help mt-3 mb-0">Avisos automáticos generados por el backend al registrar cirugías y solicitudes.</p>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string? Rol { get; set; }
    private string perfil = "administrador";
    private bool vacia;
    private bool desconocido;
    private bool cargando = true;
    private bool errorCarga;
    private bool procesando;
    private string? mensajeOk;
    private string? mensajeError;
    private List<NotificacionDTO> avisos = [];

    protected override async Task OnParametersSetAsync()
    {
        vacia = Rol == "sin-avisos";
        // La bandeja siempre es la del usuario de la sesión; /notificaciones/{rol} se acepta solo si coincide.
        perfil = Vista.Perfil.Clave;
        desconocido = Rol is not null && Rol != "sin-avisos" && Rol != perfil;

        if (!vacia && !desconocido)
        {
            await CargarNotificaciones();
        }
        else
        {
            cargando = false;
        }
    }

    private async Task CargarNotificaciones()
    {
        cargando = true;
        errorCarga = false;
        mensajeError = null;
        try
        {
            avisos = await NotificacionService.ListarAsync();
            await Contador.ActualizarAsync();
        }
        catch (Exception ex)
        {
            avisos = [];
            errorCarga = true;
            mensajeError = "No se pudieron cargar las notificaciones: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task MarcarLeida(int id)
    {
        procesando = true;
        mensajeError = null;
        try
        {
            await NotificacionService.MarcarLeidaAsync(id);
            var item = avisos.FirstOrDefault(a => a.Id == id);
            if (item != null) item.Leida = true;
            mensajeOk = "Aviso marcado como leído.";
            await Contador.ActualizarAsync();
        }
        catch (Exception ex)
        {
            mensajeError = "Error al marcar aviso: " + ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task MarcarTodasLeidas()
    {
        procesando = true;
        mensajeError = null;
        try
        {
            int marcadas = await NotificacionService.MarcarTodasLeidasAsync();
            foreach (var a in avisos) a.Leida = true;
            mensajeOk = $"Se marcaron {marcadas} notificaciones como leídas.";
            await Contador.ActualizarAsync();
        }
        catch (Exception ex)
        {
            mensajeError = "Error al marcar notificaciones: " + ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }
}
