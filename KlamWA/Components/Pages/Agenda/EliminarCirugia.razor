@page "/agenda/eliminar/{Id:int}"

<PageTitle>Eliminar cirugía</PageTitle>

@if (cirugia is null)
{
    <EstadoVacio Titulo="Cirugía no encontrada" Enlace="/agenda/lista" TextoEnlace="Volver a la lista" />
}
else
{
    <PageHeader Titulo="Eliminar cirugía" Subtitulo="@($"CIR-{Id:000} · {cirugia.Procedimiento}")" />
    <div class="card" style="max-width:700px">
        <div class="card-body">
            <p>Confirma que deseas eliminar esta programación.</p>
            <dl class="row mb-0">
                <dt class="col-sm-4">Fecha</dt><dd class="col-sm-8">@cirugia.Inicio.ToString("dd/MM/yyyy HH:mm")</dd>
                <dt class="col-sm-4">Paciente</dt><dd class="col-sm-8">@cirugia.Paciente</dd>
                <dt class="col-sm-4">Cliente</dt><dd class="col-sm-8">@cirugia.Cliente</dd>
            </dl>
        </div>
        <div class="card-footer d-flex gap-2">
            <BotonDemo Clase="btn-danger" Mensaje="Demostración: la cirugía no se eliminó.">Confirmar eliminación</BotonDemo>
            <a class="btn btn-outline-secondary" href="/agenda/cirugia/@Id">Cancelar</a>
        </div>
    </div>
    <AvisoDemostracion />
}

@code {
    [Parameter] public int Id { get; set; }
    private CirugiaMock? cirugia;
    protected override void OnParametersSet() =>
        cirugia = DatosAgenda.Cirugias.FirstOrDefault(c => c.Id == Id);
}
