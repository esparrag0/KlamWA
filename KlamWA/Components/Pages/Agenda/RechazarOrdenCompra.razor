@page "/agenda/cirugia/{Id:int}/rechazar-oc"
@inject NavigationManager Nav

<PageTitle>Rechazar orden de compra</PageTitle>

@if (c == null)
{
    <div class="alert alert-warning">Cirugía no encontrada.</div>
    <a class="btn btn-outline-secondary" href="/agenda/lista">Volver a la lista</a>
}
else
{
    <PageHeader Titulo="Rechazar o solicitar corrección" Subtitulo="@($"CIR-{Id:000} · Comunica el motivo a {c.Cliente}")" />

    @if (mensaje is not null) { <div class="alert alert-info" role="status">@mensaje</div> }
    <EditForm Model="ViewModel" OnValidSubmit="Confirmar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card mb-3" style="max-width:720px">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Documento observado</label>
                    <input class="form-control" value="@DatosClientes.OrdenCompra" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="motivo">Motivo / Mensaje para la clínica</label>
                    <InputText id="motivo" class="form-control" @bind-Value="ViewModel.Motivo" />
                    <ValidationMessage For="() => ViewModel.Motivo" />
                </div>
                <div class="alert alert-warning mb-0">
                    <div class="fw-bold">La clínica podrá corregir el archivo</div>
                    El mensaje aparecerá junto al botón para adjuntar una copia más nítida.
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">Confirmar rechazo y habilitar resubida</button>
                <a class="btn btn-outline-secondary" href="/agenda/cirugia/@Id/revisar-oc">Cancelar</a>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }
    private CirugiaMock? c;
    private string? mensaje;
    private RechazoViewModel ViewModel { get; set; } = new()
    {
        DocumentoObservado = DatosClientes.OrdenCompra,
        Motivo = "La orden de compra no se puede leer. Suba una copia más nítida.",
        HabilitarResubida = true
    };

    protected override void OnParametersSet()
    {
        c = DatosAgenda.Cirugias.FirstOrDefault(x => x.Id == Id);
    }

    private void Confirmar()
    {
        mensaje = "Rechazo de ejemplo. La orden de compra no cambió de estado.";
    }
}
