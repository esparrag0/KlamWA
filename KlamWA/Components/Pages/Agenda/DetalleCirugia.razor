@inject VistaPreviaRol Vista
@inject ICirugiaService CirugiaSvc
@page "/agenda/cirugia/{Id:int}"
@using KlamWA.Components.Shared
@using KlamWA.Servicios

<PageTitle>Detalle de cirugía</PageTitle>

@if (cargando)
{
    <p class="text-muted"><span class="spinner-border spinner-border-sm me-2" role="status"></span>Cargando cirugía…</p>
}
else if (error != null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@error</span>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="Cargar">Reintentar</button>
    </div>
    <a href="/agenda/lista">Volver a la lista</a>
}
else if (c == null)
{
    <div class="alert alert-warning">Cirugía no encontrada.</div>
    <a href="/agenda/lista">Volver a la lista</a>
}
else
{
    <PageHeader Titulo="@("Cirugía #" + c.Id)" Subtitulo="@c.Procedimiento">
        <EstadoBadge Estado="@c.Estado" />
        @if (Vista.Perfil.Clave == "administrador") { <a class="btn btn-primary" href="/agenda/editar/@c.Id">Editar</a><a class="btn btn-outline-danger" href="/agenda/eliminar/@c.Id">Eliminar</a> }
        <a class="btn btn-outline-dark" href="/agenda/lista">Volver</a>
    </PageHeader>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">Datos de la cirugía</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Procedimiento</dt><dd class="col-sm-8">@c.Procedimiento</dd>
                        <dt class="col-sm-4">Inicio</dt><dd class="col-sm-8">@c.Inicio.ToString("dd/MM/yyyy HH:mm")</dd>
                        <dt class="col-sm-4">Fin</dt><dd class="col-sm-8">@(c.Fin?.ToString("dd/MM/yyyy HH:mm") ?? "Sin definir")</dd>
                        <dt class="col-sm-4">Doctor</dt><dd class="col-sm-8">@c.Doctor</dd>
                        <dt class="col-sm-4">Paciente</dt><dd class="col-sm-8">@c.Paciente</dd>
                        <dt class="col-sm-4">Diagnóstico</dt><dd class="col-sm-8">@c.Diagnostico</dd>
                        <dt class="col-sm-4">Clínica u hospital</dt><dd class="col-sm-8">@c.Clinica</dd>
                        <dt class="col-sm-4">Cliente</dt><dd class="col-sm-8">@c.Cliente</dd>
                        <dt class="col-sm-4">Equipo</dt><dd class="col-sm-8">@(c.Equipo == "" ? "Sin equipo asignado" : c.Equipo)</dd>
                        @if (c.Equipo != "")
                        {
                            <dt class="col-sm-4">Marca del equipo</dt><dd class="col-sm-8">@(c.EquipoMarca == "" ? "No registrada" : c.EquipoMarca)</dd>
                        }
                        <dt class="col-sm-4">Bandeja instrumental</dt><dd class="col-sm-8">@(c.Bandeja == "" ? "Sin bandeja asignada" : c.Bandeja)</dd>
                        @if (c.Estado == "Cancelada")
                        {
                            <dt class="col-sm-4">Motivo de cancelación</dt><dd class="col-sm-8">@c.MotivoCancelacion</dd>
                        }
                    </dl>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-header">Consumibles de la cirugía</div>
                @if (c.Consumibles.Count == 0)
                {
                    <div class="card-body text-muted">Esta cirugía no tiene consumibles asignados.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Consumible</th><th>Marca</th><th>Medida</th><th>Despachado</th><th>Consumido</th><th>Diferencia</th></tr></thead>
                            <tbody>
                                @foreach (var insumo in c.Consumibles)
                                {
                                    <tr><td>@insumo.Nombre</td><td>@insumo.Marca</td><td>@insumo.Medida</td><td>@insumo.Despachada</td><td>@(insumo.Consumida?.ToString() ?? "Pendiente")</td><td>@(insumo.Diferencia?.ToString() ?? "—")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        @if (Vista.Perfil.Clave is "administrador" or "cliente") {
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header">Cotización</div>
                <div class="card-body">
                    @if (c.PrecioCotizacion is double precio)
                    {
                        <div class="fs-4">S/ @precio.ToString("N2")</div>
                        <span class="badge text-bg-secondary">@c.EstadoCotizacion</span>
                    }
                    else
                    {
                        <span class="text-muted">Sin cotización</span>
                    }
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header">Cierre de insumos</div>
                @if (c.Estado != "Culminada")
                {
                    <div class="card-body">
                        <p class="text-muted mb-0">La orden de compra y el comparativo se habilitan cuando el administrador marca la cirugía como culminada.</p>
                    </div>
                }
                else if (!esClinica)
                {
                    <div class="card-body">
                        <p class="text-muted mb-0">Este cliente es particular: no adjunta orden de compra al cierre.</p>
                    </div>
                }
                else if (cierre != null)
                {
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Orden de compra</span>
                            <DocumentoEstadoBadge Estado="@cierre.EstadoOc" />
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Consumo real</span>
                            <DocumentoEstadoBadge Estado="@cierre.EstadoConsumo" />
                        </div>
                        @if (cierre.EstadoOc == DatosCierre.OcRechazado && !string.IsNullOrWhiteSpace(cierre.MotivoRechazo))
                        {
                            <div class="list-group-item small text-danger">@cierre.MotivoRechazo</div>
                        }
                        @if (Vista.Perfil.Clave == "cliente" && cierre.PuedeAdjuntarOc)
                        {
                            <a class="list-group-item list-group-item-action fw-semibold" href="/agenda/cirugia/@c.Id/orden-compra">
                                Adjuntar orden de compra
                            </a>
                        }
                        @if (Vista.Perfil.Clave == "administrador" && cierre.PuedeRevisarOc)
                        {
                            <a class="list-group-item list-group-item-action fw-semibold" href="/agenda/cirugia/@c.Id/revisar-oc">
                                Revisar orden de compra
                            </a>
                        }
                        @if (Vista.Perfil.Clave == "administrador" && cierre.PuedeRegistrarConsumo)
                        {
                            <a class="list-group-item list-group-item-action fw-semibold" href="/inventario/consumos/registrar/@c.Id">
                                Registrar consumo real
                            </a>
                        }
                        @if (Vista.Perfil.Clave == "administrador" && cierre.PuedeVerComparativo)
                        {
                            <a class="list-group-item list-group-item-action fw-semibold" href="/reportes/comparativo/@c.Id">
                                Ver despachado vs. consumido
                            </a>
                        }
                        @if (Vista.Perfil.Clave == "administrador" && cierre.EstadoOc == DatosCierre.OcPorAdjuntar)
                        {
                            <div class="list-group-item text-muted small">Esperando a que la clínica adjunte la orden de compra.</div>
                        }
                    </div>
                }
            </div>
            @if (Vista.Perfil.Clave == "administrador" && c.SolicitudId is int solicitudId)
            {
                <div class="card">
                    <div class="card-header">Relacionado</div>
                    <div class="list-group list-group-flush">
                        <a class="list-group-item list-group-item-action" href="/solicitudes/revision/@solicitudId">Ver solicitud</a>
                        <a class="list-group-item list-group-item-action" href="/historial-documental?solicitud=@solicitudId">Ver documentación</a>
                    </div>
                </div>
            }
        </div>
    }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private CirugiaDetalleViewModel? c;
    private CierreCirugiaMock? cierre;
    private bool esClinica;
    private bool cargando;
    private string? error;

    protected override Task OnParametersSetAsync() => Cargar();

    private async Task Cargar()
    {
        cargando = true;
        error = null;
        c = null;
        cierre = null;
        esClinica = false;
        try
        {
            c = await CirugiaSvc.FindById(Id);
            if (c != null)
            {
                // El cierre (orden de compra / consumo real) aún usa los datos de ejemplo de otro módulo.
                esClinica = c.TipoCliente == "CLINICA_HOSPITAL";
                cierre = DatosCierre.De(c.Id);
            }
        }
        catch (ServicioException ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
