@inject VistaPreviaRol Vista
@page "/agenda/lista"
@using KlamWA.Components.Shared

<PageTitle>Lista de cirugías</PageTitle>

<PageHeader Titulo="Lista de cirugías" Subtitulo="Cirugías asociadas a tu perfil (datos de ejemplo)">
    @if (Vista.Perfil.Clave is "administrador" or "instrumentista") { <a class="btn btn-outline-secondary" href="/agenda">Ver calendario</a> }
    @if (Vista.Perfil.Clave == "administrador") { <a class="btn btn-primary" href="/agenda/nueva">Nueva cirugía</a> }
</PageHeader>

<FiltrosCirugia OnFiltrar="AplicarFiltros" />
<TablaCirugias Cirugias="Filas" />

@code {
    private FiltroCirugiaVista filtro = new();
    private IEnumerable<CirugiaMock> Filas => FiltrosAgenda.Aplicar(DatosAgenda.ParaPerfil(Vista.Perfil.Clave), filtro);
    private void AplicarFiltros(FiltroCirugiaVista nuevo) => filtro = nuevo;
}
