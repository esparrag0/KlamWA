@page "/agenda/historial"
@inject VistaPreviaRol Vista
@inject ICirugiaConsultaService Consulta
@using KlamWA.DTOs
@using KlamWA.Servicios

<PageTitle>Historial de cirugías</PageTitle>

<PageHeader Titulo="@(Vista.Perfil.Clave == "cliente" ? "Mis cirugías anteriores" : "Historial de cirugías")"
            Subtitulo="Cirugías culminadas y canceladas, consultadas en la base de datos">
    <a class="btn btn-outline-secondary" href="/agenda">Volver a la agenda</a>
</PageHeader>

<div class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label for="hist-tipo" class="form-label">Tipo de cliente</label>
        <select id="hist-tipo" class="form-select" @bind="tipoCliente">
            <option value="CLINICA_HOSPITAL">Clínica / hospital</option>
            <option value="PACIENTE_PARTICULAR">Paciente particular</option>
        </select>
    </div>
    <div class="col-md-3">
        <label for="hist-id" class="form-label">ID del cliente</label>
        <input id="hist-id" type="number" min="1" class="form-control" @bind="idCliente" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" @onclick="ConsultarAsync" disabled="@cargando">Consultar</button>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (!consultado)
{
    <div class="alert alert-info">Seleccione el tipo y el ID del cliente, y pulse Consultar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>FECHA</th>
                    <th>INICIO</th>
                    <th>FIN</th>
                    <th>PROCEDIMIENTO</th>
                    <th>DOCTOR</th>
                    <th>MOTIVO DE CANCELACIÓN</th>
                    <th>ESTADO</th>
                </tr>
            </thead>
            <tbody>
                @foreach (CirugiaHistorialDTO c in historial)
                {
                    <tr>
                        <td>@c.FechaHoraInicio.ToString("dd/MM/yyyy")</td>
                        <td>@c.FechaHoraInicio.ToString("HH:mm")</td>
                        <td>@(c.FechaHoraFin is { } fin ? fin.ToString("HH:mm") : "—")</td>
                        <td>@c.TipoProcedimiento</td>
                        <td>@c.DoctorNombre</td>
                        <td>@(c.MotivoCancelacion ?? "—")</td>
                        <td><EstadoBadge Estado="@EtiquetaEstado(c.Estado)" /></td>
                    </tr>
                }
                @if (historial.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Este cliente no tiene cirugías culminadas ni canceladas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string tipoCliente = "CLINICA_HOSPITAL";
    private int? idCliente;
    private bool cargando;
    private bool consultado;
    private string? error;
    private List<CirugiaHistorialDTO> historial = [];

    private async Task ConsultarAsync()
    {
        error = null;
        if (idCliente is null or <= 0)
        {
            error = "Ingrese un ID de cliente válido.";
            consultado = false;
            return;
        }

        cargando = true;
        try
        {
            historial = await Consulta.HistorialClienteAsync(tipoCliente, idCliente.Value);
            consultado = true;
        }
        catch (HttpRequestException ex)
        {
            error = ex.Message;
            consultado = false;
        }
        finally
        {
            cargando = false;
        }
    }

    private static string EtiquetaEstado(string estado) => estado switch
    {
        "FINALIZADA" => "Culminada",
        "CANCELADA" => "Cancelada",
        _ => estado
    };
}