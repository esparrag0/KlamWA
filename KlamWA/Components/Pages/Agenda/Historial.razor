@page "/agenda/historial"
@using KlamWA.DTOs
@using KlamWA.Servicios
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "PACIENTE_PARTICULAR,CLINICA_HOSPITAL")]
@inject ICirugiaConsultaService Consulta

<PageTitle>Mis cirugías anteriores</PageTitle>
<PageHeader Titulo="Mis cirugías anteriores" Subtitulo="Cirugías culminadas y canceladas">
    <a class="btn btn-outline-secondary" href="/agenda">Volver a la agenda</a>
</PageHeader>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (cargando)
{
    <div class="card p-4 text-center text-muted">Cargando historial...</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light"><tr><th>FECHA</th><th>INICIO</th><th>FIN</th><th>PROCEDIMIENTO</th><th>DOCTOR</th><th>MOTIVO DE CANCELACIÓN</th><th>ESTADO</th></tr></thead>
            <tbody>
                @foreach (CirugiaHistorialDTO c in historial)
                {
                    <tr>
                        <td>@c.FechaHoraInicio.ToString("dd/MM/yyyy")</td>
                        <td>@c.FechaHoraInicio.ToString("HH:mm")</td>
                        <td>@(c.FechaHoraFin is { } fin ? fin.ToString("HH:mm") : "—")</td>
                        <td>@c.TipoProcedimiento</td><td>@c.DoctorNombre</td>
                        <td>@(c.MotivoCancelacion ?? "—")</td>
                        <td><EstadoBadge Estado="@EtiquetaEstado(c.Estado)" /></td>
                    </tr>
                }
                @if (historial.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay cirugías culminadas ni canceladas.</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool cargando = true;
    private string? error;
    private List<CirugiaHistorialDTO> historial = [];

    protected override async Task OnInitializedAsync()
    {
        try { historial = await Consulta.HistorialClienteAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { cargando = false; }
    }

    private static string EtiquetaEstado(string estado) => estado switch
    {
        "FINALIZADA" => "Culminada",
        "CANCELADA" => "Cancelada",
        _ => estado
    };
}
