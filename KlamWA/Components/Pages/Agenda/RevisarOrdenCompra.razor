@page "/agenda/cirugia/{Id:int}/revisar-oc"
@inject NavigationManager Nav

<PageTitle>Revisar orden de compra</PageTitle>

@if (c == null || cierre == null)
{
    <div class="alert alert-warning">Cirugía no encontrada.</div>
    <a class="btn btn-outline-secondary" href="/agenda/lista">Volver a la lista</a>
}
else if (!cierre.PuedeRevisarOc)
{
    <PageHeader Titulo="Revisión de orden de compra" Subtitulo="@($"CIR-{Id:000} · {c.Cliente}")">
        <DocumentoEstadoBadge Estado="@cierre.EstadoOc" />
        <a class="btn btn-outline-dark" href="/agenda/cirugia/@Id">Volver</a>
    </PageHeader>
    <div class="alert alert-info">No hay una orden de compra pendiente de revisión.</div>
}
else
{
    <PageHeader Titulo="Revisar orden de compra" Subtitulo="@($"CIR-{Id:000} · {c.Procedimiento} · {c.Cliente}")">
        <EstadoBadge Estado="@c.Estado" />
        <a class="btn btn-outline-dark" href="/agenda/cirugia/@Id">Volver</a>
    </PageHeader>

    <p class="text-muted">Revisa el archivo antes de cambiar su estado. El consumo real se habilita solo si la OC queda validada.</p>
    @if (mensaje is not null) { <div class="alert alert-info" role="status">@mensaje</div> }

    <div class="row g-3 mb-3">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header">Documento de cierre</div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Documento</th><th>Estado</th><th>Archivo</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@DatosClientes.OrdenCompra</td>
                                <td><DocumentoEstadoBadge Estado="@cierre.EstadoOc" /></td>
                                <td>@(string.IsNullOrWhiteSpace(cierre.ArchivoOc) ? "Sin archivo adjunto" : cierre.ArchivoOc)</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="form-text">Pida una copia más nítida si no se distingue el detalle de insumos.</div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header">Decisión administrativa</div>
                <div class="card-body">
                    <p class="fw-bold mb-1">@c.Procedimiento</p>
                    <p class="mb-3">@c.Inicio.ToString("dd/MM/yyyy HH:mm") · @c.Doctor</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-success" @onclick="Validar">Validar orden de compra</button>
                        <a class="btn btn-outline-danger" href="/agenda/cirugia/@Id/rechazar-oc">Rechazar / pedir corrección</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private CirugiaMock? c;
    private CierreCirugiaMock? cierre;
    private string? mensaje;

    protected override void OnParametersSet()
    {
        c = DatosAgenda.Cirugias.FirstOrDefault(x => x.Id == Id);
        cierre = c == null ? null : DatosCierre.De(Id);
    }

    private void Validar()
    {
        mensaje = "Validación de ejemplo. La orden de compra no cambió de estado.";
    }
}
