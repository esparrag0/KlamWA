@page "/agenda/nueva"
@page "/agenda/editar/{Id:int}"
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@using Microsoft.AspNetCore.Authorization
@using KlamWA.Components.Shared
@using KlamWA.ViewModels
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject NavigationManager Nav
@inject ICirugiaService CirugiaService
@inject IBandejaService BandejaService

<PageTitle>Formulario de cirugía</PageTitle>

<PageHeader Titulo="@(Id == null ? "Registrar cirugía" : "Editar cirugía #" + Id)"
            Subtitulo="Los datos se guardan en el sistema" />

@if (MensajeError != null)
{
    <div class="alert alert-danger">@MensajeError</div>
}

@if (cargando)
{
    <div class="alert alert-info">Cargando datos...</div>
}
else if (opciones != null)
{
    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card" style="max-width:900px">
            <div class="card-body">
                <div class="row g-3">
                    <CampoForm Etiqueta="Tipo de procedimiento">
                        <InputText class="form-control" @bind-Value="ViewModel.TipoProcedimiento" />
                        <ValidationMessage For="() => ViewModel.TipoProcedimiento" />
                    </CampoForm>
                    <CampoForm Etiqueta="Doctor">
                        <InputText class="form-control" @bind-Value="ViewModel.Doctor" />
                        <ValidationMessage For="() => ViewModel.Doctor" />
                    </CampoForm>
                    <CampoForm Etiqueta="Diagnóstico" Columnas="col-12">
                        <InputTextArea class="form-control" rows="2" @bind-Value="ViewModel.Diagnostico" />
                        <ValidationMessage For="() => ViewModel.Diagnostico" />
                    </CampoForm>
                    <CampoForm Etiqueta="Inicio">
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="ViewModel.FechaHoraInicio" />
                        <ValidationMessage For="() => ViewModel.FechaHoraInicio" />
                    </CampoForm>
                    <CampoForm Etiqueta="Fin">
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="ViewModel.FechaHoraFin" />
                        <ValidationMessage For="() => ViewModel.FechaHoraFin" />
                    </CampoForm>
                    <CampoForm Etiqueta="Cliente (clínica u hospital, o paciente particular)" Columnas="col-12">
                        <InputSelect class="form-select" @bind-Value="ViewModel.ClienteClave">
                            <option value="">-- Seleccione --</option>
                            @foreach (OpcionDTO cliente in opciones.Clientes)
                            {
                                <option value="@($"{cliente.Tipo}:{cliente.Id}")">@cliente.Nombre (@TextoTipoCliente(cliente.Tipo))</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => ViewModel.ClienteClave" />
                    </CampoForm>
                    <CampoForm Etiqueta="Equipo">
                        <InputSelect class="form-select" @bind-Value="ViewModel.IdEquipo">
                            <option value="0">-- Ninguno --</option>
                            @foreach (OpcionDTO equipo in opciones.Equipos)
                            {
                                <option value="@equipo.Id">@equipo.Nombre</option>
                            }
                        </InputSelect>
                        <div class="form-text">Solo se listan los equipos disponibles.</div>
                    </CampoForm>
                    <CampoForm Etiqueta="Procedimiento de la bandeja">
                        <InputSelect class="form-select" @bind-Value="ViewModel.Procedimiento" @bind-Value:after="CambiarProcedimiento">
                            <option value="">-- Todos --</option>
                            @foreach (string procedimiento in Procedimientos)
                            {
                                <option value="@procedimiento">@procedimiento</option>
                            }
                        </InputSelect>
                    </CampoForm>
                    <CampoForm Etiqueta="Bandeja instrumental" Columnas="col-12">
                        <InputSelect class="form-select" @bind-Value="ViewModel.IdBandeja" @bind-Value:after="CargarPlantilla">
                            <option value="0">-- Ninguna --</option>
                            @foreach (BandejaDTO bandeja in BandejasFiltradas)
                            {
                                <option value="@bandeja.IdBandeja">@bandeja.Tipo · @bandeja.Procedimiento</option>
                            }
                        </InputSelect>
                        <div class="form-text">Solo bandejas esterilizadas y sin otra cirugía asignada.</div>
                    </CampoForm>
                    @if (plantilla != null)
                    {
                        <div class="col-12">
                            <div class="alert alert-light border mb-0">
                                <strong>Plantilla de @plantilla.Tipo (@plantilla.Procedimiento)</strong>
                                @if (plantilla.Consumibles.Count == 0)
                                {
                                    <div class="text-muted small mt-1">Esta bandeja no tiene consumibles asociados.</div>
                                }
                                else
                                {
                                    <ul class="mb-0 mt-2">
                                        @foreach (ConsumibleBandejaDTO consumible in plantilla.Consumibles)
                                        {
                                            <li>@consumible.NombreComercial · @consumible.Medida · @consumible.Cantidad previstos</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@guardando">Guardar</button>
                <a class="btn btn-outline-secondary" href="@(Id == null ? "/agenda/lista" : $"/agenda/cirugia/{Id}")">Cancelar</a>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private CirugiaViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }
    private OpcionesCirugiaDTO? opciones;
    private BandejaDTO? plantilla;
    private bool cargando = true;
    private bool guardando;

    // Procedimientos de las plantillas registradas (RF13: cráneo/cabeza y columna)
    private IEnumerable<string> Procedimientos =>
        opciones!.Bandejas.Select(b => b.Procedimiento ?? "").Where(p => p != "").Distinct().OrderBy(p => p);

    private IEnumerable<BandejaDTO> BandejasFiltradas =>
        opciones!.Bandejas.Where(b => ViewModel.Procedimiento == "" || b.Procedimiento == ViewModel.Procedimiento
                                      || b.IdBandeja == ViewModel.IdBandeja);

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        MensajeError = null;
        plantilla = null;
        try
        {
            opciones = await CirugiaService.OpcionesAsync();
            if (Id is int id)
            {
                CirugiaDTO? cirugia = await CirugiaService.ObtenerAsync(id);
                if (cirugia == null)
                {
                    Nav.NavigateTo("/agenda/lista");
                    return;
                }
                ViewModel = new CirugiaViewModel(cirugia);
                AgregarAsignadosActuales(cirugia);
                await CargarPlantilla();
            }
            else
            {
                ViewModel = new CirugiaViewModel();
            }
        }
        catch (ServicioException ex)
        {
            MensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    // El equipo y la bandeja de la propia cirugía no salen como "disponibles": se agregan para poder conservarlos
    private void AgregarAsignadosActuales(CirugiaDTO cirugia)
    {
        if (cirugia.IdEquipo is int idEquipo && opciones!.Equipos.All(e => e.Id != idEquipo))
        {
            opciones.Equipos.Add(new OpcionDTO { Id = idEquipo, Nombre = cirugia.EquipoNombre ?? $"Equipo {idEquipo}" });
        }
        if (cirugia.IdBandeja is int idBandeja && opciones!.Bandejas.All(b => b.IdBandeja != idBandeja))
        {
            opciones.Bandejas.Add(new BandejaDTO { IdBandeja = idBandeja, Tipo = cirugia.BandejaTipo ?? $"Bandeja {idBandeja}" });
        }
    }

    private async Task CambiarProcedimiento()
    {
        if (ViewModel.IdBandeja > 0 && BandejasFiltradas.All(b => b.IdBandeja != ViewModel.IdBandeja))
        {
            ViewModel.IdBandeja = 0;
        }
        await CargarPlantilla();
    }

    // Muestra los consumibles de la plantilla elegida (RF13)
    private async Task CargarPlantilla()
    {
        plantilla = null;
        if (ViewModel.IdBandeja <= 0)
        {
            return;
        }
        try
        {
            plantilla = await BandejaService.ObtenerAsync(ViewModel.IdBandeja);
        }
        catch (ServicioException ex)
        {
            MensajeError = ex.Message;
        }
    }

    private async Task Guardar()
    {
        guardando = true;
        MensajeError = null;
        try
        {
            CirugiaDTO guardada = Id is int id
                ? await CirugiaService.ModificarAsync(id, ViewModel.ToFormDTO())
                : await CirugiaService.RegistrarAsync(ViewModel.ToFormDTO());
            Nav.NavigateTo($"/agenda/cirugia/{guardada.IdCirugia}?guardado=1");
        }
        catch (ServicioException ex)
        {
            // Mensaje de la BL (cruce de horario, bandeja no esterilizada, etc.)
            MensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private string TextoTipoCliente(string? tipo) => tipo == "PACIENTE_PARTICULAR" ? "particular" : "clínica";
}
