@page "/agenda/nueva"
@page "/agenda/registrar"
@page "/agenda/editar/{Id:int}"
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@using Microsoft.AspNetCore.Authorization
@using KlamWA.Components.Shared
@using KlamWA.ViewModels
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject NavigationManager Nav
@inject ICirugiaService CirugiaService
@inject IBandejaService BandejaService

<PageTitle>Formulario de cirugía</PageTitle>

<PageHeader Titulo="@(Id == null ? "Registrar cirugía" : "Editar cirugía #" + Id)"
            Subtitulo="Los datos se guardan en el sistema" />

@if (MensajeError != null)
{
    <div class="alert alert-danger">@MensajeError</div>
}

@if (cargando)
{
    <div class="alert alert-info">Cargando datos...</div>
}
else if (opciones != null)
{
    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card" style="max-width:900px">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12"><h2 class="h6 text-primary border-bottom pb-2">Datos de cirugía</h2></div>
                    <CampoForm Etiqueta="Tipo de procedimiento">
                        <InputSelect class="form-select" @bind-Value="ViewModel.TipoProcedimiento" @bind-Value:after="CambiarProcedimiento">
                            <option value="">-- Seleccione un procedimiento --</option>
                            @foreach (string nombre in procedimientosRegistrados) { <option value="@nombre">@nombre</option> }
                        </InputSelect>
                        <ValidationMessage For="() => ViewModel.TipoProcedimiento" />
                    </CampoForm>
                    <CampoForm Etiqueta="Doctor">
                        <InputText class="form-control" @bind-Value="ViewModel.Doctor" />
                        <ValidationMessage For="() => ViewModel.Doctor" />
                    </CampoForm>
                    <CampoForm Etiqueta="Diagnóstico" Columnas="col-12">
                        <InputTextArea class="form-control" rows="2" @bind-Value="ViewModel.Diagnostico" />
                        <ValidationMessage For="() => ViewModel.Diagnostico" />
                    </CampoForm>
                    <div class="col-12"><h2 class="h6 text-primary border-bottom pb-2 mt-2">Programación</h2></div>
                    <CampoForm Etiqueta="Inicio">
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="ViewModel.FechaHoraInicio" />
                        <ValidationMessage For="() => ViewModel.FechaHoraInicio" />
                    </CampoForm>
                    <CampoForm Etiqueta="Fin">
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="ViewModel.FechaHoraFin" />
                        <ValidationMessage For="() => ViewModel.FechaHoraFin" />
                    </CampoForm>
                    <CampoForm Etiqueta="Cliente (clínica u hospital, o paciente particular)" Columnas="col-12">
                        <InputSelect class="form-select" @bind-Value="ViewModel.ClienteClave">
                            <option value="">-- Seleccione --</option>
                            @foreach (OpcionDTO cliente in opciones.Clientes)
                            {
                                <option value="@($"{cliente.Tipo}:{cliente.Id}")">@cliente.Nombre (@TextoTipoCliente(cliente.Tipo))</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => ViewModel.ClienteClave" />
                    </CampoForm>
                    <div class="col-12"><h2 class="h6 text-primary border-bottom pb-2 mt-2">Bandeja y consumibles</h2></div>
                    <CampoForm Etiqueta="Equipo">
                        <InputSelect class="form-select" @bind-Value="ViewModel.IdEquipo">
                            <option value="0">-- Ninguno --</option>
                            @foreach (OpcionDTO equipo in opciones.Equipos)
                            {
                                <option value="@equipo.Id">@equipo.Nombre</option>
                            }
                        </InputSelect>
                    </CampoForm>
                    <CampoForm Etiqueta="Plantilla de bandeja" Columnas="col-12">
                        <InputSelect class="form-select" @bind-Value="ViewModel.IdBandeja" @bind-Value:after="CargarPlantilla">
                            <option value="0">-- Seleccione una bandeja compatible --</option>
                            @foreach (BandejaDTO bandeja in BandejasFiltradas)
                            {
                                <option value="@bandeja.IdBandeja">@bandeja.Tipo · @bandeja.Procedimiento</option>
                            }
                        </InputSelect>
                        <div class="form-text">Se muestran las plantillas configuradas para este procedimiento.</div>
                    </CampoForm>
                    @if (plantilla != null)
                    {
                        <div class="col-12">
                            <div class="alert alert-light border mb-2"><strong>@plantilla.Tipo</strong> · Las cantidades previstas corresponden solo a esta cirugía.</div>
                            <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="() => personalizarConsumibles = true">Personalizar consumibles</button>
                            <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Consumible</th><th style="width:140px">Cantidad prevista</th><th style="width:100px">Acción</th></tr></thead><tbody>
                                @foreach (var linea in ViewModel.ConsumiblesPrevistos.ToList())
                                {
                                    int idConsumible = linea.Key;
                                    <tr><td>@NombreConsumible(idConsumible)</td><td><input type="number" class="form-control form-control-sm" min="1" disabled="@(!personalizarConsumibles)" @bind="ViewModel.ConsumiblesPrevistos[idConsumible]" /></td><td><button type="button" class="btn btn-sm btn-outline-danger" disabled="@(!personalizarConsumibles)" @onclick="() => QuitarConsumible(idConsumible)">Quitar</button></td></tr>
                                }
                            </tbody></table></div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <select class="form-select form-select-sm" style="max-width:280px" @bind="consumibleAgregar"><option value="0">-- Agregar consumible --</option>@foreach (var consumible in catalogoConsumibles.Where(x => x.Activo && !ViewModel.ConsumiblesPrevistos.ContainsKey(x.IdConsumible))) { <option value="@consumible.IdConsumible">@consumible.NombreComercial</option> }</select>
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!personalizarConsumibles || consumibleAgregar == 0)" @onclick="AgregarConsumible">Agregar consumible</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RestablecerEstandar">Restablecer valores estándar</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@guardando">Guardar</button>
                <a class="btn btn-outline-secondary" href="@(Id == null ? "/agenda/lista" : $"/agenda/cirugia/{Id}")">Cancelar</a>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private CirugiaViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }
    private OpcionesCirugiaDTO? opciones;
    private BandejaDTO? plantilla;
    private List<ConsumibleDTO> catalogoConsumibles = [];
    private List<string> procedimientosRegistrados = [];
    private int consumibleAgregar;
    private bool cargando = true;
    private bool guardando;
    private bool personalizarConsumibles;

    private IEnumerable<BandejaDTO> BandejasFiltradas =>
        opciones!.Bandejas.Where(b => string.Equals(b.Procedimiento?.Trim(), ViewModel.TipoProcedimiento.Trim(), StringComparison.OrdinalIgnoreCase)
                                      || b.IdBandeja == ViewModel.IdBandeja);

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        MensajeError = null;
        plantilla = null;
        try
        {
            opciones = await CirugiaService.OpcionesAsync();
            procedimientosRegistrados = opciones.Procedimientos;
            catalogoConsumibles = await BandejaService.ListarConsumiblesAsync();
            if (Id is int id)
            {
                CirugiaDTO? cirugia = await CirugiaService.ObtenerAsync(id);
                if (cirugia == null)
                {
                    Nav.NavigateTo("/agenda/lista");
                    return;
                }
                ViewModel = new CirugiaViewModel(cirugia);
                if (!procedimientosRegistrados.Contains(ViewModel.TipoProcedimiento, StringComparer.OrdinalIgnoreCase))
                    procedimientosRegistrados.Add(ViewModel.TipoProcedimiento);
                AgregarAsignadosActuales(cirugia);
                await CargarPlantilla();
                ViewModel.ConsumiblesPrevistos = new(cirugia.ConsumiblesPrevistos);
                personalizarConsumibles = plantilla is not null
                    && !ViewModel.ConsumiblesPrevistos.OrderBy(x => x.Key).SequenceEqual(
                        plantilla.Consumibles.ToDictionary(x => x.IdConsumible, x => x.Cantidad).OrderBy(x => x.Key));
            }
            else
            {
                ViewModel = new CirugiaViewModel();
            }
        }
        catch (ServicioException ex)
        {
            MensajeError = ex.Message;
        }
        catch (HttpRequestException)
        {
            MensajeError = "No se pudo conectar con el servicio de cirugías";
        }
        finally
        {
            cargando = false;
        }
    }

    // El equipo de la propia cirugía puede no salir como disponible; se conserva al editar.
    private void AgregarAsignadosActuales(CirugiaDTO cirugia)
    {
        if (cirugia.IdEquipo is int idEquipo && opciones!.Equipos.All(e => e.Id != idEquipo))
        {
            opciones.Equipos.Add(new OpcionDTO { Id = idEquipo, Nombre = cirugia.EquipoNombre ?? $"Equipo {idEquipo}" });
        }
        if (cirugia.IdBandeja is int idBandeja && opciones!.Bandejas.All(b => b.IdBandeja != idBandeja))
        {
            opciones.Bandejas.Add(new BandejaDTO { IdBandeja = idBandeja, Tipo = cirugia.BandejaTipo ?? $"Bandeja {idBandeja}" });
        }
    }

    private async Task CambiarProcedimiento()
    {
        ViewModel.IdBandeja = 0;
        ViewModel.ConsumiblesPrevistos.Clear();
        if (opciones is not null)
        {
            var disponibles = await CirugiaService.OpcionesAsync(ViewModel.TipoProcedimiento);
            opciones.Bandejas = disponibles.Bandejas;
            if (BandejasFiltradas.Count() == 1) ViewModel.IdBandeja = BandejasFiltradas.Single().IdBandeja;
        }
        await CargarPlantilla();
    }

    // Muestra los consumibles de la plantilla elegida (RF13)
    private async Task CargarPlantilla()
    {
        plantilla = null;
        personalizarConsumibles = false;
        ViewModel.ConsumiblesPrevistos.Clear();
        if (ViewModel.IdBandeja <= 0)
        {
            return;
        }
        try
        {
            plantilla = await BandejaService.ObtenerAsync(ViewModel.IdBandeja);
            RestablecerEstandar();
        }
        catch (ServicioException ex)
        {
            MensajeError = ex.Message;
        }
    }

    private void RestablecerEstandar()
    {
        ViewModel.ConsumiblesPrevistos = plantilla?.Consumibles
            .ToDictionary(x => x.IdConsumible, x => x.Cantidad) ?? [];
        personalizarConsumibles = false;
    }
    private void QuitarConsumible(int id) => ViewModel.ConsumiblesPrevistos.Remove(id);
    private void AgregarConsumible()
    {
        if (consumibleAgregar > 0 && !ViewModel.ConsumiblesPrevistos.ContainsKey(consumibleAgregar))
            ViewModel.ConsumiblesPrevistos[consumibleAgregar] = 1;
        consumibleAgregar = 0;
    }
    private string NombreConsumible(int id) => catalogoConsumibles.FirstOrDefault(x => x.IdConsumible == id)?.NombreComercial ?? $"Consumible {id}";

    private async Task Guardar()
    {
        guardando = true;
        MensajeError = null;
        try
        {
            CirugiaDTO guardada = Id is int id
                ? await CirugiaService.ModificarAsync(id, ViewModel.ToFormDTO())
                : await CirugiaService.RegistrarAsync(ViewModel.ToFormDTO());
            Nav.NavigateTo($"/agenda/cirugia/{guardada.IdCirugia}?guardado=1");
        }
        catch (ServicioException ex)
        {
            // Muestra la validación devuelta por la BL.
            MensajeError = ex.Message;
        }
        catch (HttpRequestException)
        {
            MensajeError = "No se pudo conectar con el servicio de cirugías";
        }
        finally
        {
            guardando = false;
        }
    }

    private string TextoTipoCliente(string? tipo) => tipo == "PACIENTE_PARTICULAR" ? "particular" : "clínica";
}
