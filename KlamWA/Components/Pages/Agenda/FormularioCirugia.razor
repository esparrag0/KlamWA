@page "/agenda/nueva"
@page "/agenda/registrar"
@page "/agenda/editar/{Id:int}"
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@using Microsoft.AspNetCore.Authorization
@using KlamWA.Components.Shared
@using KlamWA.ViewModels
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject NavigationManager Nav
@inject ICirugiaService CirugiaService
@inject IBandejaService BandejaService

<PageTitle>Formulario de cirugía</PageTitle>

<PageHeader Titulo="@(Id == null ? "Registrar cirugía" : "Editar cirugía #" + Id)"
            Subtitulo="Los datos se guardan en el sistema" />

@if (MensajeError != null)
{
    <div class="alert alert-danger">@MensajeError</div>
}

@if (cargando)
{
    <div class="card"><Espera Texto="Consultando procedimientos, clientes y bandejas" /></div>
}
else if (opciones != null)
{
    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card" style="max-width:900px">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12"><h2 class="h6 text-primary border-bottom pb-2">Datos de cirugía</h2></div>
                    <CampoForm Obligatorio="true" Etiqueta="Tipo de procedimiento">
                        @* «Otro» abre un campo libre: antes, un procedimiento que no
                           estuviera en el catálogo no se podía registrar. *@
                        <select class="form-select" value="@SeleccionProcedimiento" @onchange="CambiarSeleccionProcedimiento">
                            <option value="">-- Seleccione un procedimiento --</option>
                            @foreach (string nombre in procedimientosRegistrados) { <option value="@nombre">@nombre</option> }
                            <option value="@OtroProcedimiento">Otro (escribirlo abajo)</option>
                        </select>
                        @if (esOtroProcedimiento)
                        {
                            <input class="form-control mt-2" placeholder="Nombre del procedimiento"
                                   value="@ViewModel.TipoProcedimiento" @onchange="EscribirProcedimiento" />
                        }
                        <ValidationMessage For="() => ViewModel.TipoProcedimiento" />
                    </CampoForm>
                    <CampoForm Obligatorio="true" Etiqueta="Doctor">
                        <InputText class="form-control" @bind-Value="ViewModel.Doctor" />
                        <ValidationMessage For="() => ViewModel.Doctor" />
                    </CampoForm>

                    @* Paciente: buscar al registrado O escribirlo a mano. Antes eran dos
                       campos seguidos y parecía que había que rellenar los dos; el «o»
                       del medio deja claro que es una cosa u otra. La búsqueda es por
                       escritura y no una lista desplegable, porque con cientos de
                       pacientes el desplazamiento es inviable. *@
                    <div class="col-12">
                        <fieldset class="bloque-opciones">
                            <legend>Paciente</legend>
                            <p class="form-text mt-0 mb-3">Basta con una de las dos formas.</p>

                            <label class="form-label" for="buscar-paciente">Buscar un paciente ya registrado</label>
                            <input id="buscar-paciente" class="form-control" list="lista-pacientes" autocomplete="off"
                                   placeholder="Escribe el nombre o el documento" value="@busquedaPaciente"
                                   @onchange="SeleccionarPacienteRegistrado" />
                            <datalist id="lista-pacientes">
                                @foreach (OpcionDTO paciente in PacientesRegistrados)
                                {
                                    <option value="@EtiquetaPaciente(paciente)"></option>
                                }
                            </datalist>
                            <div class="form-text">
                                @if (pacienteRegistradoId > 0)
                                {
                                    <span class="text-success">Datos completados desde el registro. Puedes corregirlos abajo si hace falta.</span>
                                }
                                else
                                {
                                    @($"{PacientesRegistrados.Count()} paciente(s) registrado(s). Escribe para ir filtrando.")
                                }
                            </div>

                            <div class="separador-o"><span>o escríbelos a mano</span></div>

                            <div class="row g-3">
                                <CampoForm Etiqueta="Paciente (persona que se opera)" Obligatorio="true">
                                    <InputText class="form-control" @bind-Value="ViewModel.PacienteNombre" />
                                    <ValidationMessage For="() => ViewModel.PacienteNombre" />
                                </CampoForm>
                                <CampoForm Etiqueta="Documento del paciente (DNI u otro)">
                                    <InputText class="form-control" @bind-Value="ViewModel.PacienteDocumento" />
                                    <ValidationMessage For="() => ViewModel.PacienteDocumento" />
                                </CampoForm>
                            </div>
                        </fieldset>
                    </div>
                    <CampoForm Obligatorio="true" Etiqueta="Diagnóstico" Columnas="col-12">
                        <InputTextArea class="form-control" rows="2" @bind-Value="ViewModel.Diagnostico" />
                        <ValidationMessage For="() => ViewModel.Diagnostico" />
                    </CampoForm>
                    <div class="col-12"><h2 class="h6 text-primary border-bottom pb-2 mt-2">Programación</h2></div>
                    <CampoForm Obligatorio="true" Etiqueta="Inicio">
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="ViewModel.FechaHoraInicio" />
                        <ValidationMessage For="() => ViewModel.FechaHoraInicio" />
                    </CampoForm>
                    <CampoForm Etiqueta="Fin">
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="ViewModel.FechaHoraFin" />
                        <ValidationMessage For="() => ViewModel.FechaHoraFin" />
                    </CampoForm>
                    @* Mismo motivo que en el paciente: la cartera de clientes crece y
                       un desplegable largo obliga a desplazarse a ciegas. *@
                    <CampoForm Obligatorio="true" Etiqueta="Cliente (clínica u hospital, o paciente particular)" Columnas="col-12">
                        <input class="form-control" list="lista-clientes" autocomplete="off"
                               placeholder="Escribe el nombre de la clínica, el hospital o el paciente"
                               value="@busquedaCliente" @onchange="SeleccionarCliente" />
                        <datalist id="lista-clientes">
                            @foreach (OpcionDTO cliente in opciones.Clientes)
                            {
                                <option value="@EtiquetaCliente(cliente)"></option>
                            }
                        </datalist>
                        <div class="form-text">
                            @if (ClienteElegido is OpcionDTO elegido)
                            {
                                <span class="text-success">Cliente elegido: @elegido.Nombre (@TextoTipoCliente(elegido.Tipo))</span>
                            }
                            else
                            {
                                @($"{opciones.Clientes.Count} cliente(s) disponibles. Escribe para ir filtrando.")
                            }
                        </div>
                        <ValidationMessage For="() => ViewModel.ClienteClave" />
                    </CampoForm>
                    <div class="col-12"><h2 class="h6 text-primary border-bottom pb-2 mt-2">Bandeja y consumibles</h2></div>
                    <CampoForm Etiqueta="Equipo">
                        <InputSelect class="form-select" @bind-Value="ViewModel.IdEquipo">
                            <option value="0">-- Ninguno --</option>
                            @foreach (OpcionDTO equipo in opciones.Equipos)
                            {
                                <option value="@equipo.Id">@equipo.Nombre</option>
                            }
                        </InputSelect>
                    </CampoForm>
                    @* Las plantillas se filtran por procedimiento, así que en una cirugía
                       nueva la lista sale vacía hasta elegirlo. Antes no lo decía y
                       parecía que no hubiera ninguna configurada. *@
                    <CampoForm Obligatorio="@(BandejasFiltradas.Any())" Etiqueta="Plantilla de bandeja" Columnas="col-12">
                        <InputSelect class="form-select" @bind-Value="ViewModel.IdBandeja" @bind-Value:after="CargarPlantilla"
                                     disabled="@(!BandejasFiltradas.Any())">
                            <option value="0">@TextoBandejaVacia</option>
                            @foreach (BandejaDTO bandeja in BandejasFiltradas)
                            {
                                <option value="@bandeja.IdBandeja">@bandeja.Tipo · @bandeja.Procedimiento</option>
                            }
                        </InputSelect>
                        <div class="form-text">@AyudaBandeja</div>
                    </CampoForm>
                    @if (plantilla != null)
                    {
                        @* Todo dentro de una tarjeta: el nombre y el botón de ajuste
                           arriba, la explicación, la tabla y, solo en modo ajuste, la
                           fila para añadir. Antes el botón flotaba suelto encima de la
                           tabla y nada decía que servía para desbloquear los campos. *@
                        <div class="col-12">
                            <div class="card">
                                <div class="section-heading d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div class="plantilla-titulo">
                                        <h2>@plantilla.Tipo</h2>
                                        <span>Cantidades previstas solo para esta cirugía</span>
                                    </div>
                                    <button type="button" class="btn btn-sm @(personalizarConsumibles ? "btn-primary" : "btn-outline-secondary")"
                                            @onclick="() => personalizarConsumibles = !personalizarConsumibles">
                                        @(personalizarConsumibles ? "Terminar de ajustar" : "Ajustar cantidades")
                                    </button>
                                </div>
                                <div class="card-body pb-0">
                                    <p class="form-text mt-0 mb-0">
                                        @(personalizarConsumibles
                                            ? "Cambia las cantidades, quita lo que no se vaya a usar o añade un consumible. Solo afecta a esta cirugía: la plantilla no se modifica."
                                            : "Son las cantidades estándar de la plantilla. Si esta cirugía necesita otras, pulsa «Ajustar cantidades».")
                                    </p>
                                </div>
                                <div class="table-responsive">
                                    <table class="table align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Consumible</th>
                                                <th style="width:160px">Cantidad prevista</th>
                                                <th class="acciones">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var linea in ViewModel.ConsumiblesPrevistos.ToList())
                                            {
                                                int idConsumible = linea.Key;
                                                <tr>
                                                    <td>@NombreConsumible(idConsumible)</td>
                                                    <td>
                                                        <input type="number" class="form-control form-control-sm" min="1"
                                                               disabled="@(!personalizarConsumibles)"
                                                               @bind="ViewModel.ConsumiblesPrevistos[idConsumible]" />
                                                    </td>
                                                    <td class="acciones">
                                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                                disabled="@(!personalizarConsumibles)"
                                                                @onclick="() => QuitarConsumible(idConsumible)">Quitar</button>
                                                    </td>
                                                </tr>
                                            }
                                            @if (ViewModel.ConsumiblesPrevistos.Count == 0)
                                            {
                                                <tr><td colspan="3" class="text-muted">Esta plantilla no tiene consumibles previstos.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (personalizarConsumibles)
                                {
                                    <div class="card-footer d-flex flex-wrap gap-2 align-items-center">
                                        <select class="form-select form-select-sm" style="max-width:300px" @bind="consumibleAgregar">
                                            <option value="0">Elige un consumible para añadir</option>
                                            @foreach (var consumible in catalogoConsumibles.Where(x => x.Activo && !ViewModel.ConsumiblesPrevistos.ContainsKey(x.IdConsumible)))
                                            {
                                                <option value="@consumible.IdConsumible">@consumible.NombreComercial</option>
                                            }
                                        </select>
                                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(consumibleAgregar == 0)" @onclick="AgregarConsumible">Añadir</button>
                                        <button type="button" class="btn btn-sm btn-link ms-auto" @onclick="RestablecerCantidades">Restablecer la plantilla</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@guardando">Guardar</button>
                <a class="btn btn-outline-secondary" href="@(Id == null ? "/agenda/lista" : $"/agenda/cirugia/{Id}")">Cancelar</a>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private CirugiaViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }
    private OpcionesCirugiaDTO? opciones;
    private BandejaDTO? plantilla;
    private List<ConsumibleDTO> catalogoConsumibles = [];
    private List<string> procedimientosRegistrados = [];
    private int consumibleAgregar;
    private bool cargando = true;
    private bool guardando;
    private bool personalizarConsumibles;

    private IEnumerable<BandejaDTO> BandejasFiltradas =>
        opciones!.Bandejas.Where(b => string.Equals(b.Procedimiento?.Trim(), ViewModel.TipoProcedimiento.Trim(), StringComparison.OrdinalIgnoreCase)
                                      || b.IdBandeja == ViewModel.IdBandeja);

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        MensajeError = null;
        plantilla = null;
        try
        {
            opciones = await CirugiaService.OpcionesAsync();
            procedimientosRegistrados = opciones.Procedimientos;
            catalogoConsumibles = await BandejaService.ListarConsumiblesAsync();
            if (Id is int id)
            {
                CirugiaDTO? cirugia = await CirugiaService.ObtenerAsync(id);
                if (cirugia == null)
                {
                    Nav.NavigateTo("/agenda/lista");
                    return;
                }
                ViewModel = new CirugiaViewModel(cirugia);
                if (!procedimientosRegistrados.Contains(ViewModel.TipoProcedimiento, StringComparer.OrdinalIgnoreCase))
                    procedimientosRegistrados.Add(ViewModel.TipoProcedimiento);
                AgregarAsignadosActuales(cirugia);
                await CargarPlantilla();
                ViewModel.ConsumiblesPrevistos = new(cirugia.ConsumiblesPrevistos);
                personalizarConsumibles = plantilla is not null
                    && !ViewModel.ConsumiblesPrevistos.OrderBy(x => x.Key).SequenceEqual(
                        plantilla.Consumibles.ToDictionary(x => x.IdConsumible, x => x.Cantidad).OrderBy(x => x.Key));
            }
            else
            {
                ViewModel = new CirugiaViewModel();
            }
            // Los campos de búsqueda arrancan con lo ya elegido; si no, al editar
            // saldrían vacíos y parecería que se perdió el cliente.
            busquedaCliente = ClienteElegido is OpcionDTO elegido ? EtiquetaCliente(elegido) : "";
            busquedaPaciente = "";
            pacienteRegistradoId = 0;
            esOtroProcedimiento = false;
        }
        catch (ServicioException ex)
        {
            MensajeError = MensajeDeError.Texto(ex);
        }
        catch (HttpRequestException)
        {
            MensajeError = "No se pudo conectar con el servicio de cirugías";
        }
        finally
        {
            cargando = false;
        }
    }

    // El equipo de la propia cirugía puede no salir como disponible; se conserva al editar.
    private void AgregarAsignadosActuales(CirugiaDTO cirugia)
    {
        if (cirugia.IdEquipo is int idEquipo && opciones!.Equipos.All(e => e.Id != idEquipo))
        {
            opciones.Equipos.Add(new OpcionDTO { Id = idEquipo, Nombre = cirugia.EquipoNombre ?? $"Equipo {idEquipo}" });
        }
        if (cirugia.IdBandeja is int idBandeja && opciones!.Bandejas.All(b => b.IdBandeja != idBandeja))
        {
            opciones.Bandejas.Add(new BandejaDTO { IdBandeja = idBandeja, Tipo = cirugia.BandejaTipo ?? $"Bandeja {idBandeja}" });
        }
    }

    private async Task CambiarProcedimiento()
    {
        ViewModel.IdBandeja = 0;
        ViewModel.ConsumiblesPrevistos.Clear();
        if (opciones is not null)
        {
            var disponibles = await CirugiaService.OpcionesAsync(ViewModel.TipoProcedimiento);
            opciones.Bandejas = disponibles.Bandejas;
            if (BandejasFiltradas.Count() == 1) ViewModel.IdBandeja = BandejasFiltradas.Single().IdBandeja;
        }
        await CargarPlantilla();
    }

    // Muestra los consumibles de la plantilla elegida (RF13)
    private async Task CargarPlantilla()
    {
        plantilla = null;
        personalizarConsumibles = false;
        ViewModel.ConsumiblesPrevistos.Clear();
        if (ViewModel.IdBandeja <= 0)
        {
            return;
        }
        try
        {
            plantilla = await BandejaService.ObtenerAsync(ViewModel.IdBandeja);
            RestablecerEstandar();
        }
        catch (ServicioException ex)
        {
            MensajeError = MensajeDeError.Texto(ex);
        }
    }

    /// Devuelve las cantidades de la plantilla sin salir del modo de ajuste,
    /// que es lo que espera quien pulsa «Restablecer la plantilla» para seguir
    /// retocando desde los valores estándar.
    private void RestablecerCantidades()
    {
        ViewModel.ConsumiblesPrevistos = plantilla?.Consumibles
            .ToDictionary(x => x.IdConsumible, x => x.Cantidad) ?? [];
    }

    private void RestablecerEstandar()
    {
        RestablecerCantidades();
        personalizarConsumibles = false;
    }
    private void QuitarConsumible(int id) => ViewModel.ConsumiblesPrevistos.Remove(id);
    private void AgregarConsumible()
    {
        if (consumibleAgregar > 0 && !ViewModel.ConsumiblesPrevistos.ContainsKey(consumibleAgregar))
            ViewModel.ConsumiblesPrevistos[consumibleAgregar] = 1;
        consumibleAgregar = 0;
    }
    private string NombreConsumible(int id) => catalogoConsumibles.FirstOrDefault(x => x.IdConsumible == id)?.NombreComercial ?? $"Consumible {id}";

    private async Task Guardar()
    {
        guardando = true;
        MensajeError = null;
        try
        {
            CirugiaDTO guardada = Id is int id
                ? await CirugiaService.ModificarAsync(id, ViewModel.ToFormDTO())
                : await CirugiaService.RegistrarAsync(ViewModel.ToFormDTO());
            Nav.NavigateTo($"/agenda/cirugia/{guardada.IdCirugia}?guardado=1");
        }
        catch (ServicioException ex)
        {
            // Muestra la validación devuelta por la BL.
            MensajeError = MensajeDeError.Texto(ex);
        }
        catch (HttpRequestException)
        {
            MensajeError = "No se pudo conectar con el servicio de cirugías";
        }
        finally
        {
            guardando = false;
        }
    }

    private int pacienteRegistradoId;
    private string busquedaPaciente = "";
    private string busquedaCliente = "";

    private IEnumerable<OpcionDTO> PacientesRegistrados =>
        opciones?.Clientes.Where(c => c.Tipo == "PACIENTE_PARTICULAR") ?? [];

    // La etiqueta es lo que se escribe y lo que se ve en las sugerencias, así que
    // lleva nombre y documento: con homónimos, el documento desempata.
    private static string EtiquetaPaciente(OpcionDTO p) =>
        string.IsNullOrWhiteSpace(p.Documento) ? p.Nombre : $"{p.Nombre} · DNI {p.Documento}";

    private string EtiquetaCliente(OpcionDTO c) => $"{c.Nombre} ({TextoTipoCliente(c.Tipo)})";

    private OpcionDTO? ClienteElegido =>
        opciones?.Clientes.FirstOrDefault(c => $"{c.Tipo}:{c.Id}" == ViewModel.ClienteClave);

    /// Busca por etiqueta completa, por nombre o por documento: quien escribe
    /// puede teclear el DNI entero sin acordarse del nombre exacto.
    private void SeleccionarPacienteRegistrado(ChangeEventArgs e)
    {
        busquedaPaciente = e.Value?.ToString()?.Trim() ?? "";
        OpcionDTO? paciente = PacientesRegistrados.FirstOrDefault(p =>
                string.Equals(EtiquetaPaciente(p), busquedaPaciente, StringComparison.OrdinalIgnoreCase))
            ?? PacientesRegistrados.FirstOrDefault(p =>
                string.Equals(p.Nombre, busquedaPaciente, StringComparison.OrdinalIgnoreCase))
            ?? PacientesRegistrados.FirstOrDefault(p =>
                !string.IsNullOrWhiteSpace(p.Documento)
                && string.Equals(p.Documento, busquedaPaciente, StringComparison.OrdinalIgnoreCase));

        if (paciente is null)
        {
            pacienteRegistradoId = 0;
            return;
        }
        pacienteRegistradoId = paciente.Id;
        busquedaPaciente = EtiquetaPaciente(paciente);
        ViewModel.PacienteNombre = paciente.Nombre;
        ViewModel.PacienteDocumento = paciente.Documento;
    }

    private void SeleccionarCliente(ChangeEventArgs e)
    {
        busquedaCliente = e.Value?.ToString()?.Trim() ?? "";
        OpcionDTO? cliente = opciones?.Clientes.FirstOrDefault(c =>
                string.Equals(EtiquetaCliente(c), busquedaCliente, StringComparison.OrdinalIgnoreCase))
            ?? opciones?.Clientes.FirstOrDefault(c =>
                string.Equals(c.Nombre, busquedaCliente, StringComparison.OrdinalIgnoreCase));

        // Sin coincidencia se deja vacío para que la validación del formulario avise;
        // si no, se guardaría una cirugía con un cliente que nadie eligió.
        ViewModel.ClienteClave = cliente is null ? "" : $"{cliente.Tipo}:{cliente.Id}";
        if (cliente is not null) busquedaCliente = EtiquetaCliente(cliente);
    }

    private string TextoTipoCliente(string? tipo) => tipo == "PACIENTE_PARTICULAR" ? "particular" : "clínica";

    // --- Procedimiento «Otro» ------------------------------------------------
    private const string OtroProcedimiento = "__otro";
    private bool esOtroProcedimiento;

    private string SeleccionProcedimiento =>
        esOtroProcedimiento ? OtroProcedimiento : ViewModel.TipoProcedimiento;

    private async Task CambiarSeleccionProcedimiento(ChangeEventArgs e)
    {
        string valor = e.Value?.ToString() ?? "";
        esOtroProcedimiento = valor == OtroProcedimiento;
        ViewModel.TipoProcedimiento = esOtroProcedimiento ? "" : valor;
        await CambiarProcedimiento();
    }

    private async Task EscribirProcedimiento(ChangeEventArgs e)
    {
        ViewModel.TipoProcedimiento = e.Value?.ToString()?.Trim() ?? "";
        await CambiarProcedimiento();
    }

    // --- Ayuda del desplegable de bandejas -----------------------------------
    private bool SinProcedimiento => string.IsNullOrWhiteSpace(ViewModel.TipoProcedimiento);

    private string TextoBandejaVacia =>
        SinProcedimiento ? "Elige primero el tipo de procedimiento"
        : BandejasFiltradas.Any() ? "-- Seleccione una bandeja compatible --"
        : "No hay plantillas para este procedimiento";

    private string AyudaBandeja =>
        SinProcedimiento
            ? "Las plantillas se filtran por procedimiento: en cuanto elijas uno, aparecerán aquí las compatibles."
            : BandejasFiltradas.Any()
                ? "Plantillas configuradas para este procedimiento. Es obligatoria cuando hay alguna compatible."
                : $"Ninguna plantilla está configurada para «{ViewModel.TipoProcedimiento}». Puedes guardar la cirugía sin bandeja y crear la plantilla en Inventario y logística → Plantillas de bandejas.";
}
