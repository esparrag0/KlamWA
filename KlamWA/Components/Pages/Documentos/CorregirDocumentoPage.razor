@page "/mis-solicitudes/corregir/{Id:int}"
@inject NavigationManager Nav;

<PageTitle>Corregir documento</PageTitle>

<h3 class="mb-3">Corregir documento</h3>
<p class="text-muted">SOL-@Id.ToString("000") · Revisión observada por administración</p>

<div class="alert alert-warning">
    <div class="fw-bold">@DocumentoObservado rechazada</div>
    @Motivo Adjunta una copia legible.
</div>

@if (mensaje is not null) { <div class="alert alert-info" role="status">@mensaje</div> }

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-bold">Nueva versión del documento</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">@DocumentoObservado corregida</label>
                    <InputFile class="form-control" accept=".pdf,.jpg,.jpeg,.png" OnChange="SeleccionarArchivo" />
                    <div class="form-text">@(archivoSeleccionado is null ? "Seleccione un archivo para la demostración." : $"Seleccionado: {archivoSeleccionado}")</div>
                </div>
                <div class="d-flex gap-2">
                    <button tabindex="2" type="button" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(archivoSeleccionado)" @onclick="EnviarDocumento">
                        Enviar documento corregido
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-bold">Seguimiento</div>
            <div class="card-body">
                <p class="mb-0">Versión anterior: Rechazada</p>
                <p>Nueva versión: Por revisar</p>
                <p class="small text-muted">La solicitud volverá a revisión tras el envío.</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private string DocumentoObservado { get; set; } = "Receta médica";
    private string Motivo { get; set; } = "";
    private string? archivoSeleccionado;
    private string? mensaje;
    private void SeleccionarArchivo(InputFileChangeEventArgs e) => archivoSeleccionado = e.File.Name;

    protected override void OnParametersSet()
    {
        var solicitud = DatosClientes.Solicitudes.FirstOrDefault(s => s.Id == Id);
        if (solicitud is null) { Nav.NavigateTo("/mis-solicitudes"); return; }
        DocumentoObservado = solicitud.Documentos.FirstOrDefault(d => d.Estado == "Rechazado")?.Tipo ?? "Receta médica";
        Motivo = solicitud.MotivoRechazo;
    }

    private void EnviarDocumento() {
        mensaje = "Archivo seleccionado. No se envió ni reemplazó el documento en esta entrega.";
    }
}
