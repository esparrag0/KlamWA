@page "/solicitudes"
@inject NavigationManager Nav;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Solicitudes de cirugía</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Solicitudes de cirugía</h3>


</div>

<div class="row mb-3">
    <div class="col">
        <label class="form-label">Buscar</label>
        <input tabindex="1" class="form-control" placeholder="Código, paciente o cliente..." @bind="Filtro" />
    </div>
    <div class="col">
        <label class="form-label">Estado</label>
        <select tabindex="2" class="form-select" @bind="FiltroEstado">
            <option value="">Todas las solicitudes</option>
            @foreach (string estado in Estados) {
                <option value="@estado">@estado</option>
            }
        </select>
    </div>
</div>

@if (!Solicitudes.Any()) {
    <div class="alert alert-info">No hay solicitudes registradas.</div>
}
else {
    <QuickGrid Items="Solicitudes" Pagination="Paginacion" Class="table table-striped table-hover">
        <PropertyColumn Title="Solicitud" Property="s => s.Codigo" Sortable="true" />
        <PropertyColumn Title="Cliente / Paciente" Property="@(s => s.Cliente + " · " + s.Paciente)" Sortable="true" />
        <PropertyColumn Title="Procedimiento" Property="s => s.Procedimiento" Sortable="true" />
        <PropertyColumn Title="Fecha solicitada" Property="s => s.FechaSolicitada" Format="dd/MM/yyyy HH:mm"
                        Sortable="true" />
        <PropertyColumn Title="Estado" Property="s => s.Estado" Sortable="true" />
        <TemplateColumn Title="Acciones">
            <button class="btn btn-primary btn-sm" @onclick="() => RevisarSolicitud(context.Id)">
                Revisar
            </button>
            <button class="btn btn-outline-primary btn-sm" @onclick="() => VerHistorial(context.Id)">
                Historial
            </button>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="Paginacion"></Paginator>
}

@code {
    private IQueryable<SolicitudViewModel> Solicitudes { get; set; } = Enumerable.Empty<SolicitudViewModel>().AsQueryable();
    private string Filtro { get; set; } = string.Empty;
    private string FiltroEstado { get; set; } = string.Empty;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 5 };

    private string[] Estados { get; } = [
        "Por revisar",
        "Documentación incompleta",
        "Rechazada · Resubida habilitada",
        "Aprobada"
    ];

    protected override void OnInitialized() =>
        Solicitudes = DatosClientes.Solicitudes.Select(DatosClientes.ParaRevision).AsQueryable();

    private void RevisarSolicitud(int id) {
        Nav.NavigateTo($"/solicitudes/revision/{id}");
    }

    private void VerHistorial(int id) {
        Nav.NavigateTo($"/historial-documental?solicitud={id}");
    }
}
