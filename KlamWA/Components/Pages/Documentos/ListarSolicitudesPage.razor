@page "/solicitudes"
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject ISolicitudCirugiaService SolicitudService

<PageTitle>Solicitudes de cirugía | Klam</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="mb-1">Solicitudes de cirugía</h3>
        <p class="text-muted mb-0">Revisa la documentación y decide sobre las solicitudes recibidas</p>
    </div>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarAsync" disabled="@Cargando">Actualizar</button>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label for="buscar-solicitud" class="form-label">Buscar</label>
        <input id="buscar-solicitud" class="form-control" placeholder="Número, cliente, paciente o procedimiento" @bind="Busqueda" @bind:event="oninput" @bind:after="ReiniciarPaginacionAsync" />
    </div>
    <div class="col-md-4">
        <label for="estado-solicitud" class="form-label">Estado</label>
        <select id="estado-solicitud" class="form-select" @bind="EstadoFiltro" @bind:after="ReiniciarPaginacionAsync">
            <option value="">Todos</option>
            @foreach (var estado in Solicitudes.Select(s => s.Estado).Distinct().Order())
            {
                <option value="@estado">@estado.Replace('_', ' ')</option>
            }
        </select>
    </div>
</div>

@if (Cargando)
{
    <div class="alert alert-info">Consultando solicitudes...</div>
}
else if (Error is not null)
{
    <div class="alert alert-danger" role="alert">
        @Error
        @if (RequiereLogin) { <a href="/login" class="alert-link ms-2">Iniciar sesión</a> }
    </div>
}
else if (Filtradas.Count == 0)
{
    <div class="alert alert-info">No hay solicitudes para los filtros seleccionados.</div>
}
else
{
    <div class="table-responsive">
        <QuickGrid Items="Filtradas.AsQueryable()" Pagination="Paginacion" Class="table table-striped table-hover align-middle">
            <PropertyColumn Title="Solicitud" Property="s => s.Codigo" Sortable="true" />
            <PropertyColumn Title="Cliente" Property="s => s.Cliente" Sortable="true" />
            <PropertyColumn Title="Paciente" Property="s => s.PacienteNombre" Sortable="true" />
            <PropertyColumn Title="Procedimiento" Property="s => s.TipoProcedimiento" Sortable="true" />
            <PropertyColumn Title="Fecha solicitada" Property="s => s.FechaHoraSolicitada" Format="dd/MM/yyyy HH:mm" Sortable="true" />
            <TemplateColumn Title="Estado" Context="solicitud">
                <span class="badge text-bg-secondary">@solicitud.Estado.Replace('_', ' ')</span>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Context="solicitud">
                <a class="btn btn-sm btn-primary me-1" href="/solicitudes/revision/@solicitud.IdSolicitud">Revisar</a>
                <a class="btn btn-sm btn-outline-primary" href="/historial-documental?solicitud=@solicitud.IdSolicitud">Historial</a>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <Paginator State="Paginacion" />
}

@code {
    private List<SolicitudCirugiaDTO> Solicitudes { get; set; } = [];
    private string Busqueda { get; set; } = "";
    private string EstadoFiltro { get; set; } = "";
    private string? Error { get; set; }
    private bool Cargando { get; set; }
    private bool RequiereLogin { get; set; }
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 10 };

    private List<SolicitudCirugiaDTO> Filtradas => Solicitudes.Where(s =>
        (string.IsNullOrEmpty(EstadoFiltro) || s.Estado == EstadoFiltro) &&
        (string.IsNullOrWhiteSpace(Busqueda) ||
         s.Codigo.Contains(Busqueda, StringComparison.OrdinalIgnoreCase) ||
         s.Cliente.Contains(Busqueda, StringComparison.OrdinalIgnoreCase) ||
         s.PacienteNombre.Contains(Busqueda, StringComparison.OrdinalIgnoreCase) ||
         s.TipoProcedimiento.Contains(Busqueda, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override Task OnInitializedAsync() => CargarAsync();

    private Task ReiniciarPaginacionAsync() => Paginacion.SetCurrentPageIndexAsync(0);

    private async Task CargarAsync()
    {
        Cargando = true;
        Error = null;
        RequiereLogin = false;
        try
        {
            Solicitudes = await SolicitudService.ListarAsync();
        }
        catch (ServicioException ex)
        {
            RequiereLogin = ex.StatusCode == HttpStatusCode.Unauthorized;
            Error = ex.StatusCode switch
            {
                HttpStatusCode.Unauthorized => "La sesión del backend expiró. Inicia sesión nuevamente.",
                HttpStatusCode.Forbidden => "No tienes permiso para consultar las solicitudes.",
                _ => ex.Message
            };
        }
        catch (TaskCanceledException)
        {
            Error = "La consulta tardó demasiado. Inténtalo de nuevo.";
        }
        finally
        {
            Cargando = false;
        }
    }
}
