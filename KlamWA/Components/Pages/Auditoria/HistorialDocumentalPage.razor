@page "/historial-documental"
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@using Microsoft.AspNetCore.Authorization
@using System.Net
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject IDocumentoIngresoService DocumentoService
@inject ISolicitudCirugiaService SolicitudService

<PageTitle>Historial documental</PageTitle>

@* Se llega aquí desde una solicitud concreta. Cuando viene preseleccionada no
   se pinta el selector: la pantalla es el historial de ESA solicitud, no un
   buscador suelto. El selector queda solo para quien entre por la URL pelada. *@
<div class="surgery-breadcrumb mb-2">
    <a class="volver-atras" href="/solicitudes" aria-label="Volver a las solicitudes"><Icono Nombre="volver" Tamano="16" /> Solicitudes</a>
    <span>/</span><span>Historial documental</span>
</div>
<PageHeader Titulo="Historial documental" Subtitulo="@SubtituloPantalla">
    <button type="button" class="btn btn-outline-secondary" disabled="@(IdOperacion <= 0 || Cargando)" @onclick="ActualizarAsync"
            title="Volver a consultar" aria-label="Volver a consultar el historial">
        <Icono Nombre="recargar" Tamano="17" />
    </button>
</PageHeader>

@if (IdSolicitud is null)
{
    <div class="card mb-3">
        <div class="card-body">
            <label for="historial-solicitud" class="form-label small mb-1">Solicitud</label>
            <input id="historial-solicitud" class="form-control form-control-sm" list="lista-solicitudes-historial"
                   autocomplete="off" placeholder="Escribe el código de la solicitud o el nombre del cliente"
                   value="@busquedaSolicitud" @onchange="ElegirSolicitud" />
            <datalist id="lista-solicitudes-historial">
                @foreach (var s in Solicitudes) { <option value="@EtiquetaSolicitud(s)"></option> }
            </datalist>
            <div class="form-text">@($"{Solicitudes.Count} solicitud(es). Escribe para ir filtrando.")</div>
        </div>
    </div>
}

@if (Cargando)
{
    <div class="card"><Espera Texto="Consultando el historial documental" Filas="4" /></div>
}
else if (Error is not null)
{
    <div class="alert alert-danger" role="alert">@Error @if (RequiereLogin) { <a href="/login" class="alert-link ms-2">Iniciar sesión</a> }</div>
}
else if (IdOperacion <= 0)
{
    <EstadoVacio Titulo="Elige una solicitud" Descripcion="Selecciona una solicitud para ver las versiones de sus documentos." Enlace="/solicitudes" TextoEnlace="Ir a solicitudes" />
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr><th>Fecha y hora</th><th>Documento</th><th>Versión</th><th class="d-none d-lg-table-cell">Responsable</th><th>Estado</th><th>Motivo de rechazo</th><th>Resubida</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Registros.Skip((Pagina - 1) * PorPagina).Take(PorPagina))
            {
                <tr>
                    <td class="text-nowrap">@r.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@TextoDocumento(r.Documento)</td>
                    <td>v@(r.Version)</td>
                    <td class="d-none d-lg-table-cell">@(r.Responsable ?? "—")</td>
                    <td><DocumentoEstadoBadge Estado="@r.Estado" /></td>
                    <td>@(string.IsNullOrWhiteSpace(r.MotivoRechazo) ? "—" : r.MotivoRechazo)</td>
                    <td>@(r.Estado == "RECHAZADO" ? (r.HabilitarResubida ? "Habilitada" : "No habilitada") : "—")</td>
                </tr>
            }
            @if (Registros.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No hay documentos registrados para esta solicitud.</td></tr>
            }
        </tbody>
    </table>
    <Paginacion Total="Registros.Count" PorPagina="PorPagina" @bind-Pagina="Pagina" />
}

@code {
    [SupplyParameterFromQuery(Name = "solicitud")] public int? IdSolicitud { get; set; }
    private List<HistorialDocumentoDTO> Registros { get; set; } = [];
    private int IdOperacion { get; set; }
    private const int PorPagina = 10;
    private int Pagina { get; set; } = 1;
    private List<SolicitudCirugiaDTO> Solicitudes { get; set; } = [];
    private string busquedaSolicitud = "";

    private SolicitudCirugiaDTO? SolicitudActual =>
        Solicitudes.FirstOrDefault(s => s.IdSolicitud == IdOperacion);

    private string SubtituloPantalla => SolicitudActual is SolicitudCirugiaDTO s
        ? $"{s.Codigo} · {s.Cliente} · {s.TipoProcedimiento}"
        : "Versiones y cambios de estado de los documentos de una solicitud";

    private static string EtiquetaSolicitud(SolicitudCirugiaDTO s) =>
        $"{s.Codigo} · {s.Cliente} · {s.TipoProcedimiento}";

    private async Task ElegirSolicitud(ChangeEventArgs e)
    {
        busquedaSolicitud = e.Value?.ToString()?.Trim() ?? "";
        var elegida = Solicitudes.FirstOrDefault(s =>
                string.Equals(EtiquetaSolicitud(s), busquedaSolicitud, StringComparison.OrdinalIgnoreCase))
            ?? Solicitudes.FirstOrDefault(s =>
                string.Equals(s.Codigo, busquedaSolicitud, StringComparison.OrdinalIgnoreCase));

        IdOperacion = elegida?.IdSolicitud ?? 0;
        if (elegida is not null)
        {
            busquedaSolicitud = EtiquetaSolicitud(elegida);
            await ActualizarAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try { Solicitudes = (await SolicitudService.ListarAsync()).OrderByDescending(x => x.IdSolicitud).ToList(); }
        catch (HttpRequestException) { /* el error se mostrará al consultar */ }
    }

    private static string TextoDocumento(string tipo) => tipo switch
    {
        "DNI" => "DNI",
        "RECETA_MEDICA" => "Receta médica",
        "ORDEN_COMPRA" => "Orden de compra",
        "COMPROBANTE_PAGO" => "Comprobante de pago",
        _ => tipo
    };
    private bool Cargando { get; set; }
    private string? Error { get; set; }
    private bool RequiereLogin { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IdSolicitud is > 0)
        {
            IdOperacion = IdSolicitud.Value;
            await ActualizarAsync();
        }
    }

    private async Task ActualizarAsync()
    {
        if (IdOperacion <= 0) return;
        Cargando = true;
        Error = null;
        RequiereLogin = false;
        Registros = [];
        Pagina = 1;
        try
        {
            Registros = await DocumentoService.ConsultarHistorialAsync(IdOperacion);
        }
        catch (HttpRequestException ex)
        {
            Error = ex.StatusCode switch
            {
                HttpStatusCode.BadRequest => "El número de solicitud no es válido.",
                HttpStatusCode.Unauthorized => "Debes iniciar sesión nuevamente.",
                HttpStatusCode.Forbidden => "No tienes permiso para consultar este historial.",
                HttpStatusCode.NotFound => "No existe la solicitud indicada.",
                HttpStatusCode.Conflict => "El historial cambió. Vuelve a consultarlo.",
                HttpStatusCode.InternalServerError => MensajeDeError.Texto(ex),
                _ => "No se pudo consultar el historial. Inténtalo de nuevo."
            };
        }
        catch (TaskCanceledException)
        {
            Error = "La consulta tardó demasiado. Inténtalo de nuevo.";
        }
        finally
        {
            Cargando = false;
        }
    }
}
