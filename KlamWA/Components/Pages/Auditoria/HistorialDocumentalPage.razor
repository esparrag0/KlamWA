@page "/historial-documental"

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Historial documental</PageTitle>

<h3 class="mb-3">Historial documental</h3>
<p class="text-muted">Ciclo de documentos por operación</p>

<div class="d-flex align-items-center gap-2 mb-3">
    <label class="text-nowrap">Operación:</label>
    <select tabindex="1" class="form-select" @bind="IdOperacion">
        @foreach (var operacion in DatosClientes.Solicitudes) {
            <option value="@operacion.Id">SOL-@operacion.Id.ToString("000") · @operacion.Cliente</option>
        }
    </select>
    <button tabindex="2" type="button" class="btn btn-primary" @onclick="Actualizar">Consultar</button>
</div>

@if (!Registros.Any()) {
    <div class="alert alert-info">No hay documentos registrados para la operación.</div>
}
else {
    <QuickGrid Items="Registros" Pagination="Paginacion" Class="table table-striped table-hover">
        <PropertyColumn Title="Fecha y hora" Property="r => r.FechaHora" Format="dd/MM/yyyy HH:mm"
                        Sortable="true" />
        <PropertyColumn Title="Documento" Property="r => r.Documento" Sortable="true" />
        <PropertyColumn Title="Responsable" Property="r => r.Responsable" Sortable="true" />
        <PropertyColumn Title="Estado" Property="r => r.Estado" />
        <PropertyColumn Title="Referencia" Property="r => r.Referencia" />
    </QuickGrid>
    <Paginator State="Paginacion"></Paginator>
}

@code {
    [SupplyParameterFromQuery(Name = "solicitud")]
    public int? IdSolicitud { get; set; }

    private IQueryable<RegistroHistorialViewModel> Registros { get; set; } =
        Enumerable.Empty<RegistroHistorialViewModel>().AsQueryable();
    private int IdOperacion { get; set; } = 1;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 5 };

    protected override void OnParametersSet()
    {
        IdOperacion = DatosClientes.Solicitudes.Any(s => s.Id == IdSolicitud) ? IdSolicitud!.Value : 1;
        Actualizar();
    }

    private void Actualizar()
    {
        var solicitud = DatosClientes.Solicitudes.FirstOrDefault(s => s.Id == IdOperacion);
        if (solicitud is null)
        {
            Registros = Enumerable.Empty<RegistroHistorialViewModel>().AsQueryable();
            return;
        }
        var registros = new List<RegistroHistorialViewModel>
        {
            new() { FechaHora = solicitud.Fecha.AddDays(-2), Documento = "Solicitud",
                    Responsable = solicitud.Cliente, Estado = "Recibida", Referencia = $"SOL-{solicitud.Id:000}" }
        };
        foreach (var documento in solicitud.Documentos)
            registros.Add(new RegistroHistorialViewModel {
                FechaHora = solicitud.Fecha.AddDays(-1), Documento = documento.Tipo,
                Responsable = solicitud.Cliente, Estado = documento.Estado,
                Referencia = string.IsNullOrEmpty(documento.Archivo) ? "Sin archivo" : documento.Archivo
            });
        if (solicitud.Estado == "Aprobada")
            registros.Add(new RegistroHistorialViewModel {
                FechaHora = solicitud.Fecha.AddHours(-12), Documento = "Cotización",
                Responsable = "Administración", Estado = "Aceptada", Referencia = $"COT-{solicitud.Id:000}"
            });
        var cirugia = DatosAgenda.Cirugias.FirstOrDefault(c => c.SolicitudId == solicitud.Id);
        if (cirugia?.Estado == "Culminada" && DatosCierre.EsClinica(cirugia.Cliente))
            registros.Add(new RegistroHistorialViewModel {
                FechaHora = cirugia.Fin.AddHours(2), Documento = "Orden de compra",
                Responsable = cirugia.Cliente, Estado = DatosCierre.De(cirugia.Id).EstadoOc,
                Referencia = DatosCierre.De(cirugia.Id).ArchivoOc
            });
        Registros = registros.OrderBy(r => r.FechaHora).AsQueryable();
    }
}
