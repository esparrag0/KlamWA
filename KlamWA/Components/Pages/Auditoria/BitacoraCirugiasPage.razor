@page "/bitacora-cirugias"
@inject IAuditoriaService Auditoria
@using KlamWA.DTOs
@using KlamWA.Servicios
@using KlamWA.ViewModels

<PageTitle>Bitácora de cirugías</PageTitle>

<PageHeader Titulo="Bitácora de cirugías"
            Subtitulo="Trazabilidad de creaciones, modificaciones y cancelaciones"></PageHeader>

<div class="row g-2 align-items-end mb-3">
    <div class="col-md-2">
        <label for="bit-desde" class="form-label">Desde</label>
        <input id="bit-desde" type="date" class="form-control" @bind="desde" />
    </div>
    <div class="col-md-2">
        <label for="bit-hasta" class="form-label">Hasta</label>
        <input id="bit-hasta" type="date" class="form-control" @bind="hasta" />
    </div>
    @* Cirugías y responsables que ya han aparecido en la bitácora. Se acumulan
       y no se reemplazan: al filtrar, la lista de sugerencias no se vacía. *@
    <div class="col-md-2">
        <label for="bit-cirugia" class="form-label">ID de cirugía</label>
        <input id="bit-cirugia" type="text" class="form-control" list="lista-cirugias-bitacora"
               autocomplete="off" placeholder="Todas" @bind="idCirugiaTexto" />
        <datalist id="lista-cirugias-bitacora">
            @foreach (var sugerencia in cirugiasVistas) { <option value="@sugerencia"></option> }
        </datalist>
    </div>
    <div class="col-md-2">
        <label for="bit-responsable" class="form-label">Responsable</label>
        <input id="bit-responsable" type="text" class="form-control" list="lista-responsables-bitacora"
               autocomplete="off" placeholder="Todos" @bind="responsable" />
        <datalist id="lista-responsables-bitacora">
            @foreach (var sugerencia in responsablesVistos) { <option value="@sugerencia"></option> }
        </datalist>
    </div>
    <div class="col-md-2">
        <label for="bit-accion" class="form-label">Acción</label>
        <select id="bit-accion" class="form-select" @bind="accion">
            <option value="">Todas</option>
            @foreach (var (codigo, etiqueta) in RegistroBitacoraViewModel.Acciones)
            {
                <option value="@codigo">@etiqueta</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-primary flex-fill" @onclick="BuscarAsync" disabled="@cargando">Buscar</button>
        <button class="btn btn-outline-secondary" @onclick="LimpiarAsync" disabled="@cargando">Limpiar</button>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (!cargando && registros.Count == 0)
{
    <div class="alert alert-info">No hay cambios registrados con esos filtros.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>FECHA Y HORA</th>
                    <th>CIRUGÍA</th>
                    <th>ACCIÓN</th>
                    <th>RESPONSABLE</th>
                    <th>DETALLE</th>
                    <th class="text-end">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @foreach (RegistroBitacoraViewModel r in registros)
                {
                    <tr>
                        <td>@r.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@r.Cirugia</td>
                        <td>@r.Accion</td>
                        <td>@r.Responsable</td>
                        <td>@r.Detalle</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="/bitacora-cirugias/detalle/@r.Id">Ver cambios</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private DateTime? desde;
    private DateTime? hasta;
    private string idCirugiaTexto = "";
    private string responsable = "";
    private string accion = "";
    private bool cargando;
    private string? error;
    private List<RegistroBitacoraViewModel> registros = [];

    private readonly SortedSet<string> cirugiasVistas = new(StringComparer.OrdinalIgnoreCase);
    private readonly SortedSet<string> responsablesVistos = new(StringComparer.OrdinalIgnoreCase);

    // Acepta «1», «CIR-001» o la etiqueta de una sugerencia: se toma la primera
    // secuencia de dígitos que aparezca.
    private static int? LeerIdCirugia(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return null;
        int inicio = 0;
        while (inicio < texto.Length && !char.IsDigit(texto[inicio])) inicio++;
        if (inicio == texto.Length) return null;
        int fin = inicio;
        while (fin < texto.Length && char.IsDigit(texto[fin])) fin++;
        return int.TryParse(texto[inicio..fin], out var id) && id > 0 ? id : null;
    }

    protected override async Task OnInitializedAsync() => await BuscarAsync();

    private async Task BuscarAsync()
    {
        error = null;
        if (desde is not null && hasta is not null && desde > hasta)
        {
            error = "La fecha inicial no puede ser posterior a la final.";
            return;
        }

        cargando = true;
        try
        {
            // "Hasta" incluye todo el dia seleccionado (el backend recibe 23:59:59).
            List<AuditoriaDTO> filas = await Auditoria.ListarAsync(
                LeerIdCirugia(idCirugiaTexto),
                desde?.Date,
                hasta?.Date.AddDays(1).AddSeconds(-1),
                accion,
                responsable);
            registros = filas.Select(RegistroBitacoraViewModel.DesdeDTO).ToList();
            foreach (var r in registros)
            {
                cirugiasVistas.Add(r.Cirugia);
                if (!string.IsNullOrWhiteSpace(r.Responsable)) responsablesVistos.Add(r.Responsable);
            }
        }
        catch (HttpRequestException ex)
        {
            error = MensajeDeError.Texto(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task LimpiarAsync()
    {
        desde = null;
        hasta = null;
        idCirugiaTexto = "";
        responsable = "";
        accion = "";
        await BuscarAsync();
    }
}