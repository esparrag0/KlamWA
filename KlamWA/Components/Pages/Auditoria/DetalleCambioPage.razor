@page "/bitacora-cirugias/detalle/{Id:int}"
@inject IAuditoriaService Auditoria
@using KlamWA.DTOs
@using KlamWA.Servicios
@using KlamWA.ViewModels

<PageTitle>Detalle del cambio</PageTitle>

<PageHeader Titulo="Detalle del cambio"
            Subtitulo="Valores anteriores y posteriores registrados en la bitácora">
    <a class="btn btn-outline-secondary" href="/bitacora-cirugias">Volver a bitácora</a>
</PageHeader>

@if (cargando)
{
    <p class="text-muted">Cargando…</p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (registro is not null)
{
    <div class="alert alert-success">
        <div class="fw-bold">Responsable: @registro.Responsable</div>
        Acción: @registro.Accion de la cirugía @registro.Cirugia · @registro.FechaHora.ToString("dd/MM/yyyy HH:mm")
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>CAMPO MODIFICADO</th>
                    <th>VALOR ANTERIOR</th>
                    <th>VALOR POSTERIOR</th>
                </tr>
            </thead>
            <tbody>
                @foreach (CambioCampoViewModel c in cambios)
                {
                    <tr>
                        <td>@c.Campo</td>
                        <td>@c.ValorAnterior</td>
                        <td>@c.ValorPosterior</td>
                    </tr>
                }
                @if (cambios.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-3">
                            Esta entrada no registra diferencias de campos.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private RegistroBitacoraViewModel? registro;
    private List<CambioCampoViewModel> cambios = [];
    private bool cargando = true;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        error = null;
        try
        {
            AuditoriaDetalleDTO? detalle = await Auditoria.ObtenerAsync(Id);
            if (detalle is null)
            {
                registro = null;
                error = "No existe la entrada de bitácora solicitada.";
                return;
            }

            registro = RegistroBitacoraViewModel.DesdeDTO(detalle);
            cambios = detalle.Cambios.Select(c => new CambioCampoViewModel
            {
                Campo = c.Campo,
                ValorAnterior = c.ValorAnterior ?? "—",
                ValorPosterior = c.ValorPosterior ?? "—",
            }).ToList();
        }
        catch (HttpRequestException ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}