@page "/login"
@layout AccesoLayout
@inject NavigationManager Nav
@inject KlamWA.Services.AuthApiService Auth
@inject KlamWA.Services.SesionUsuario Sesion
@inject VistaPreviaRol Vista

<PageTitle>Iniciar sesión | Klam</PageTitle>
<div class="login-page">
    <section class="login-form-panel card">
        <img class="login-logo" src="img/klam-wordmark.svg" alt="Klam" />
        <h1>Iniciar sesión</h1>
        <p class="text-muted mb-4">Sistema de coordinación quirúrgica BIOKLAM</p>

        @if (error is not null)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <EditForm Model="ViewModel" OnValidSubmit="Entrar" autocomplete="off">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label for="login-usuario" class="form-label">Usuario</label>
                <InputText id="login-usuario" class="form-control" placeholder="Ingresa tu usuario" autocomplete="username" @bind-Value="ViewModel.UserName" />
                <ValidationMessage For="() => ViewModel.UserName" />
            </div>
            <div class="mb-4">
                <label for="login-password" class="form-label">Contraseña</label>
                <div class="password-field">
                    <InputText id="login-password" type="@(verClave ? "text" : "password")" class="form-control" placeholder="Ingresa tu contraseña" autocomplete="current-password" @bind-Value="ViewModel.Password" />
                    <button type="button" class="password-toggle" @onclick="() => verClave = !verClave" aria-label="@(verClave ? "Ocultar contraseña" : "Mostrar contraseña")"><Icono Nombre="ojo" Tamano="18" /></button>
                </div>
                <ValidationMessage For="() => ViewModel.Password" />
            </div>
            <button type="submit" class="btn btn-primary w-100 login-submit" disabled="@enviando">@(enviando ? "Ingresando…" : "Ingresar")</button>
        </EditForm>
    </section>
</div>

@code {
    private LoginViewModel ViewModel { get; set; } = new();
    private string? error;
    private bool verClave;
    private bool enviando;

    // Credenciales reales: POST login -> BL.autenticar. Los mensajes de error son los del servidor.
    private async Task Entrar()
    {
        enviando = true; error = null;
        var r = await Auth.LoginAsync(ViewModel.UserName.Trim(), ViewModel.Password);
        enviando = false;
        if (!r.Ok) { error = r.Error; ViewModel.Password = ""; return; }

        await Sesion.IniciarAsync(r.Datos!);
        var perfil = DatosAcceso.Perfil(Sesion.ClavePerfil);
        if (perfil is null) { await Sesion.CerrarAsync(); error = "Rol no reconocido: " + r.Datos!.Rol; return; }
        Vista.Mostrar(perfil);
        Nav.NavigateTo($"/inicio/{perfil.Clave}");
    }
}
