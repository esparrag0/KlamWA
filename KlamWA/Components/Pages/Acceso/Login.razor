@page "/login"
@layout AccesoLayout

<PageTitle>Iniciar sesión | Klam</PageTitle>
<div class="login-page">
    <section class="login-form-panel card">
        <img class="login-logo" src="img/klam-wordmark.svg" alt="Klam" />
        <h1>Iniciar sesión</h1>
        <p class="text-muted mb-4">Sistema de coordinación quirúrgica BIOKLAM</p>
        @if (Error is not null)
        {
            <div class="alert alert-danger" role="alert">
                @(Error switch
                {
                    "credenciales" => "Usuario o contraseña incorrectos.",
                    "rol" => "El rol de esta cuenta no tiene una vista disponible.",
                    _ => "No se pudo conectar con el servicio de acceso. Inténtalo de nuevo más tarde."
                })
            </div>
        }
        <form method="post" action="/cuenta/login" autocomplete="on">
            <AntiforgeryToken />
            <div class="mb-3"><label for="login-user" class="form-label">Usuario</label><input id="login-user" name="userName" type="text" class="form-control" placeholder="Ingresa tu usuario" autocomplete="username" required /></div>
            <div class="mb-4"><label for="login-password" class="form-label">Contraseña</label><div class="password-field"><input id="login-password" name="password" type="@(verClave ? "text" : "password")" class="form-control" placeholder="Ingresa tu contraseña" autocomplete="current-password" required /><button type="button" class="password-toggle" @onclick="() => verClave = !verClave" aria-label="@(verClave ? "Ocultar contraseña" : "Mostrar contraseña")"><Icono Nombre="ojo" Tamano="18" /></button></div></div>
            <button type="submit" class="btn btn-primary w-100 mt-4 login-submit">Ingresar</button>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    private bool verClave;
}
