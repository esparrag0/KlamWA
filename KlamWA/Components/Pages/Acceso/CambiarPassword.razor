@page "/cuenta/password"
@using KlamWA.Servicios
@using Microsoft.AspNetCore.Components.Authorization
@using KlamWA.ViewModels
@inject ICuentaService Cuenta
@inject AuthenticationStateProvider Autenticacion

<PageTitle>Cambiar contraseña | Klam</PageTitle>
<PageHeader Titulo="Cambiar contraseña" Subtitulo="@("Usuario: " + usuario)" />

@if (ok)
{
    <div class="alert alert-success" role="status">Contraseña actualizada. Úsala la próxima vez que inicies sesión.</div>
}
@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<EditForm Model="ViewModel" OnValidSubmit="Cambiar" autocomplete="off">
    <DataAnnotationsValidator />
    <div class="card" style="max-width:520px">
        <div class="card-body">
            <div class="alert alert-info small" role="note">
                <strong>Formato de la contraseña nueva:</strong> @ReglasCredenciales.TextoPassword
            </div>
            <div class="row g-3">
                <CampoForm Etiqueta="Contraseña actual *" Columnas="col-12" Para="actual">
                    <InputText id="actual" type="password" class="form-control" autocomplete="current-password" @bind-Value="ViewModel.PasswordActual" />
                    <ValidationMessage For="() => ViewModel.PasswordActual" />
                </CampoForm>
                <CampoForm Etiqueta="Contraseña nueva *" Columnas="col-12" Para="nueva">
                    <InputText id="nueva" type="password" class="form-control" maxlength="@ReglasCredenciales.MaxPassword" autocomplete="new-password" @bind-Value="ViewModel.PasswordNueva" />
                    <ValidationMessage For="() => ViewModel.PasswordNueva" />
                </CampoForm>
                <CampoForm Etiqueta="Confirmar contraseña nueva *" Columnas="col-12" Para="confirmar">
                    <InputText id="confirmar" type="password" class="form-control" maxlength="@ReglasCredenciales.MaxPassword" autocomplete="new-password" @bind-Value="ViewModel.Confirmar" />
                    <ValidationMessage For="() => ViewModel.Confirmar" />
                </CampoForm>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@enviando">@(enviando ? "Guardando…" : "Cambiar contraseña")</button>
            <a class="btn btn-outline-secondary" href="/inicio">Cancelar</a>
        </div>
    </div>
</EditForm>

@code {
    private CambiarPasswordViewModel ViewModel { get; set; } = new();
    private string usuario = string.Empty;
    private string? error;
    private bool ok;
    private bool enviando;

    protected override async Task OnInitializedAsync()
    {
        var estado = await Autenticacion.GetAuthenticationStateAsync();
        usuario = estado.User.Identity?.Name ?? string.Empty;
    }

    // La BL verifica la contraseña actual y el formato; aquí se muestra su mensaje tal cual.
    private async Task Cambiar()
    {
        enviando = true; ok = false; error = null;
        try
        {
            await Cuenta.CambiarPasswordAsync(ViewModel.PasswordActual, ViewModel.PasswordNueva);
            ok = true;
            ViewModel = new();
        }
        catch (HttpRequestException ex) { error = ex.Message; }
        enviando = false;
    }
}
