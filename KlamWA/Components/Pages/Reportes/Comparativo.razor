@page "/reportes/comparativo"
@page "/reportes/comparativo/{Id:int}"
@using KlamWA.Components.Shared
<PageTitle>Despachado vs. consumido | Klam</PageTitle>
<PageHeader Titulo="Despachado vs. consumido">
    <a class="btn btn-outline-secondary" href="/reportes/consumo">Ver uso de insumos</a>
</PageHeader>

@if (c == null)
{
    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-2">El comparativo se arma cuando el consumo de una cirugía culminada está <strong>completo</strong>.</p>
            @if (Listas.Any())
            {
                <label class="form-label small" for="cirugia">Cirugías con consumo completo</label>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var item in Listas)
                    {
                        <a class="btn btn-outline-primary btn-sm" href="/reportes/comparativo/@item.Id">CIR-@item.Id.ToString("000") · @item.Procedimiento</a>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Todavía no hay un cierre completo. Siga: Culminada → OC validada → consumo registrado.</p>
            }
        </div>
    </div>
}
else if (cierre == null || !cierre.PuedeVerComparativo)
{
    <EstadoVacio Titulo="El comparativo aún no está disponible"
                 Descripcion="Falta completar el cierre: la clínica sube la OC, administración la valida y registra el consumo real." />
    <a class="btn btn-outline-primary" href="/agenda/cirugia/@Id">Ir al detalle de la cirugía</a>
    @if (cierre?.PuedeRegistrarConsumo == true)
    {
        <a class="btn btn-primary ms-2" href="/inventario/consumos/registrar/@Id">Registrar consumo real</a>
    }
}
else
{
    <div class="card mb-3"><div class="card-header">Datos del reporte</div><div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Generado</dt><dd class="col-sm-9">@DateTime.Now.ToString("dd/MM/yyyy · HH:mm")</dd>
            <dt class="col-sm-3">Fecha de cirugía</dt><dd class="col-sm-9">@c.Inicio.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Procedimiento</dt><dd class="col-sm-9">@c.Procedimiento</dd>
            <dt class="col-sm-3">Paciente</dt><dd class="col-sm-9">@c.Paciente</dd>
            <dt class="col-sm-3">Médico responsable</dt><dd class="col-sm-9">@c.Doctor</dd>
            <dt class="col-sm-3">Cliente</dt><dd class="col-sm-9">@c.Cliente</dd>
            <dt class="col-sm-3">Orden de compra</dt><dd class="col-sm-9">@cierre.ArchivoOc · <DocumentoEstadoBadge Estado="@cierre.EstadoOc" /></dd>
        </dl>
    </div></div>
    <div class="card"><div class="card-header">Detalle de insumos</div>
    <div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0">
        <caption class="visually-hidden">Comparativo de insumos de la cirugía CIR-@c.Id.ToString("000")</caption>
        <thead class="table-light"><tr><th scope="col">Insumo</th><th scope="col">Medida</th><th scope="col" class="text-end">Despachado</th><th scope="col" class="text-end">Consumido</th><th scope="col" class="text-end">Diferencia</th></tr></thead>
        <tbody>
            @foreach (var insumo in DatosInsumos.DeCirugia(c.Id))
            {
                <tr><td>@insumo.Nombre</td><td>@insumo.Medida</td><td class="text-end">@insumo.Despachado</td><td class="text-end">@(insumo.Consumido?.ToString() ?? "Pendiente")</td><td class="text-end">@(insumo.Diferencia?.ToString() ?? "—")</td></tr>
            }
        </tbody>
    </table></div>
    <div class="card-footer d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <small class="text-muted">Diferencia: cantidad despachada menos cantidad consumida. Disponible tras consumo completo.</small>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="/agenda/cirugia/@Id">Ver cirugía</a>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Descargar Excel</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Descargar PDF</button>
        </div>
    </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    private CirugiaMock? c;
    private CierreCirugiaMock? cierre;

    private IEnumerable<CirugiaMock> Listas =>
        DatosAgenda.Cirugias.Where(x => DatosCierre.De(x.Id).PuedeVerComparativo);

    protected override void OnParametersSet()
    {
        c = Id is int id ? DatosAgenda.Cirugias.FirstOrDefault(x => x.Id == id) : null;
        cierre = c == null ? null : DatosCierre.De(c.Id);
    }
}
