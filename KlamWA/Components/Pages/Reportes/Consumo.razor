@page "/reportes/consumo"
@using KlamWA.Components.Shared
<PageTitle>Insumos más utilizados | Klam</PageTitle>
<PageHeader Titulo="Insumos más utilizados" >
    <a class="btn btn-outline-secondary" href="/reportes/comparativo">Ver comparativo</a>
</PageHeader>
<div class="card mb-3"><div class="card-header">Criterios del reporte</div><div class="card-body">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label for="desde" class="form-label small">Desde</label><input id="desde" class="form-control form-control-sm" type="date" value="2026-10-01" /></div>
        <div class="col-md-2"><label for="hasta" class="form-label small">Hasta</label><input id="hasta" class="form-control form-control-sm" type="date" value="2026-10-31" /></div>
        <div class="col-md-3"><label for="cirugia" class="form-label small">Tipo de cirugía</label><select id="cirugia" class="form-select form-select-sm"><option>Todas</option><option>Artroscopia de rodilla</option><option>Cirugía de columna</option></select></div>
        <div class="col-md-3"><label for="consumible" class="form-label small">Tipo de consumible</label><select id="consumible" class="form-select form-select-sm"><option>Todos</option><option>Fresa cortante</option><option>Cuchilla corta</option></select></div>
        <div class="col-md-2"><label for="medida" class="form-label small">Medida</label><select id="medida" class="form-select form-select-sm"><option>Todas</option><option>70 mm</option></select></div>
    </div>
    <button type="button" class="btn btn-primary mt-3" disabled>Generar reporte</button>
</div></div>
<div class="card">
    <div class="card-header">Reporte de consumo</div>
    <div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-3">Generado</dt><dd class="col-sm-9">@DateTime.Now.ToString("dd/MM/yyyy · HH:mm") (vista de ejemplo)</dd>
        <dt class="col-sm-3">Periodo</dt><dd class="col-sm-9">01/10/2026 – 31/10/2026</dd>
        <dt class="col-sm-3">Criterios aplicados</dt><dd class="col-sm-9">Todas las cirugías · Todos los consumibles · Todas las medidas</dd>
    </dl></div>
    <div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0">
        <caption class="visually-hidden">Consumo de insumos durante octubre de 2026</caption>
        <thead class="table-light"><tr><th scope="col">Consumible</th><th scope="col">Medida</th><th scope="col">Tipo de cirugía</th><th scope="col" class="text-end">Cantidad utilizada</th><th scope="col" class="text-end">Frecuencia de uso</th></tr></thead>
        <tbody>
            <tr><td>Fresa cortante</td><td>70 mm</td><td>Artroscopia de rodilla</td><td class="text-end">2</td><td class="text-end">1 cirugía</td></tr>
            <tr><td>Cuchilla corta</td><td>70 mm</td><td>Artroscopia de rodilla</td><td class="text-end">1</td><td class="text-end">1 cirugía</td></tr>
        </tbody>
    </table></div>
    <div class="card-footer d-flex flex-wrap gap-2 justify-content-between align-items-center"><small class="text-muted">Frecuencia: número de cirugías en las que se utilizó el insumo.</small><div class="d-flex gap-2"><button type="button" class="btn btn-outline-secondary btn-sm" disabled>Descargar Excel</button><button type="button" class="btn btn-outline-secondary btn-sm" disabled>Descargar PDF</button></div></div>
</div>
