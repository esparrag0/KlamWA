@page "/usuarios"
@inject IUsuarioService UsuarioService
@inject NavigationManager Navigation

<PageTitle>Usuarios | Klam</PageTitle>
<div class="breadcrumb-line">Administración <span>/</span> Usuarios</div>
<PageHeader Titulo="Usuarios" Subtitulo="Organiza las cuentas y los accesos del equipo de BIOKLAM y de los clientes con cuenta.">
    <a class="btn btn-primary" href="/usuarios/nuevo"><Icono Nombre="mas" Tamano="18" /> Nuevo usuario</a>
</PageHeader>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <Icono Nombre="alerta" Tamano="20" Clase="me-2" />
        <div>@mensajeError</div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="metric-card">
            <span>Usuarios registrados</span>
            <strong>@(metricas?.TotalRegistrados.ToString("D2") ?? "--") <small>en la plataforma</small></strong>
            <Icono Nombre="usuarios" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <span>Cuentas activas</span>
            <strong>@(metricas?.CuentasActivas.ToString("D2") ?? "--") <small>acceso habilitado</small></strong>
            <Icono Nombre="check" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <span>Roles del personal</span>
            <strong>@(metricas?.RolesPersonal.ToString("D2") ?? "03") <small>perfiles configurados</small></strong>
            <Icono Nombre="escudo" />
        </div>
    </div>
</div>

<section class="card">
    <div class="section-heading">
        <h2>Directorio de usuarios <span class="count-label">@(usuarios?.Count ?? 0)</span></h2>
        <span>Registros en MySQL</span>
    </div>

    <div class="filter-toolbar">
        <div class="search-control">
            <label class="visually-hidden" for="buscar-usuario">Buscar usuarios</label>
            <Icono Nombre="buscar" Tamano="18" />
            <input class="form-control" id="buscar-usuario" placeholder="Buscar por nombre, usuario o correo"
                   @bind="busqueda" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        </div>
        <div>
            <label class="visually-hidden" for="filtro-rol">Rol</label>
            <select class="form-select" id="filtro-rol" @bind="filtroRol" @bind:after="CargarUsuariosAsync">
                <option value="">Todos los roles</option>
                <option value="Administrador">Administrador</option>
                <option value="Vendedor">Vendedor</option>
                <option value="Instrumentista">Instrumentista</option>
                <option value="CLIENTE">Clientes con cuenta</option>
            </select>
        </div>
        <div>
            <label class="visually-hidden" for="filtro-estado">Estado</label>
            <select class="form-select" id="filtro-estado" @bind="filtroEstado" @bind:after="CargarUsuariosAsync">
                <option value="">Todos los estados</option>
                <option value="activo">Activo</option>
                <option value="inactivo">Inactivo</option>
            </select>
        </div>
        <button class="btn btn-outline-secondary" type="button" @onclick="CargarUsuariosAsync">
            <Icono Nombre="buscar" Tamano="16" /> Filtrar
        </button>
    </div>

    <p class="mobile-table-hint"><Icono Nombre="flecha" Tamano="15" /> Desliza la tabla para ver roles, estados y acciones.</p>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando usuarios...</span>
            </div>
            <p class="text-muted mt-2">Consultando usuarios en MySQL...</p>
        </div>
    }
    else if (usuarios == null || usuarios.Count == 0)
    {
        <EstadoVacio Mensaje="No se encontraron usuarios que coincidan con los filtros aplicados." />
    }
    else
    {
        <TablaBase Descripcion="Directorio de usuarios con acceso a detalle, edición y baja lógica">
            <Cabecera>
                <th scope="col">Usuario</th>
                <th scope="col">Correo electrónico</th>
                <th scope="col">Rol</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-end">Acciones</th>
            </Cabecera>
            <ChildContent>
                @foreach (var u in usuarios)
                {
                    <tr>
                        <td>
                            <a class="user-cell" href="@(u.EsCliente ? $"/clientes/{u.TipoCliente}/{u.IdCliente}" : $"/usuarios/{u.Id}?rol={u.Rol}")">
                                <span class="avatar">@u.Iniciales</span>
                                <span>
                                    <strong>@u.NombreCompleto</strong>
                                    <small>@@@u.Username</small>
                                </span>
                            </a>
                        </td>
                        <td class="email-cell">@u.Email</td>
                        <td><span class="role-chip">@u.Rol</span></td>
                        <td>
                            <EtiquetaEstado Texto="@(u.Activo ? "Activo" : "Inactivo")" Tono="@(u.Activo ? "success" : "neutral")" />
                        </td>
                        <td>
                            @if (u.EsCliente)
                            {
                                <div class="table-actions">
                                    <a href="@($"/clientes/{u.TipoCliente}/{u.IdCliente}")" title="Ver cliente" aria-label="Ver cliente de @u.NombreCompleto">
                                        <Icono Nombre="ojo" Tamano="18" />
                                    </a>
                                    <a href="@($"/clientes/editar/{u.TipoCliente}/{u.IdCliente}")" title="Editar cliente" aria-label="Editar cliente de @u.NombreCompleto">
                                        <Icono Nombre="editar" Tamano="18" />
                                    </a>
                                </div>
                            }
                            else
                            {
                            <div class="table-actions">
                                <a href="@($"/usuarios/{u.Id}?rol={u.Rol}")" title="Ver detalle" aria-label="Ver a @u.NombreCompleto">
                                    <Icono Nombre="ojo" Tamano="18" />
                                </a>
                                <a href="@($"/usuarios/editar/{u.Id}?rol={u.Rol}")" title="Editar" aria-label="Editar a @u.NombreCompleto">
                                    <Icono Nombre="editar" Tamano="18" />
                                </a>
                                @if (u.Activo)
                                {
                                    <a class="danger-link" href="@($"/usuarios/eliminar/{u.Id}?rol={u.Rol}")" title="Desactivar cuenta" aria-label="Desactivar a @u.NombreCompleto">
                                        <Icono Nombre="eliminar" Tamano="18" />
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-link p-0 text-success" title="Reactivar cuenta" @onclick="() => ReactivarUsuarioAsync(u.Id, u.Rol)">
                                        <Icono Nombre="check" Tamano="18" />
                                    </button>
                                }
                            </div>
                            }
                        </td>
                    </tr>
                }
            </ChildContent>
        </TablaBase>

        <div class="table-footer">
            <span>Mostrando @usuarios.Count usuario(s) registrado(s)</span>
            <span class="page-number" aria-label="Página 1">1</span>
        </div>
    }
</section>

@code {
    private List<UsuarioDTO>? usuarios;
    private MetricasUsuariosDTO? metricas;
    private bool cargando = true;
    private string? mensajeError;

    private string filtroRol = "";
    private string filtroEstado = "";
    private string busqueda = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarMetricasAsync();
        await CargarUsuariosAsync();
    }

    private async Task CargarMetricasAsync()
    {
        try
        {
            metricas = await UsuarioService.MetricasAsync();
        }
        catch (Exception)
        {
            // Si falla la métrica no bloquea el listado
        }
    }

    private async Task CargarUsuariosAsync()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            usuarios = await UsuarioService.ListarAsync(filtroRol, filtroEstado, busqueda);
        }
        catch (ServicioException ex)
        {
            mensajeError = ex.Message;
            usuarios = [];
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo cargar la lista de usuarios: " + ex.Message;
            usuarios = [];
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CargarUsuariosAsync();
        }
    }

    private async Task ReactivarUsuarioAsync(int id, string rol)
    {
        try
        {
            await UsuarioService.ReactivarAsync(id, rol);
            await CargarMetricasAsync();
            await CargarUsuariosAsync();
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo reactivar el usuario: " + ex.Message;
        }
    }
}
