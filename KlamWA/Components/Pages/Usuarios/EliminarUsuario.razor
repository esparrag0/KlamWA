@page "/usuarios/eliminar/{Id:int}"
@inject IUsuarioService UsuarioService
@inject NavigationManager Navigation

<PageTitle>Desactivar usuario | Klam</PageTitle>
<div class="breadcrumb-line">
    <a href="/usuarios">Usuarios</a><span>/</span>Desactivar
</div>

<PageHeader Titulo="Gestión de estado de usuario" Subtitulo="Revisión de la cuenta antes de aplicar cambios de acceso." />

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <Icono Nombre="alerta" Tamano="20" Clase="me-2" />
        <div>@errorMensaje</div>
    </div>
}

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando usuario...</span>
        </div>
        <p class="text-muted mt-2">Cargando datos del usuario...</p>
    </div>
}
else if (usuario is null)
{
    <EstadoVacio Titulo="No encontramos esa cuenta" Tono="aviso" Descripcion="Puede que ya la hayan dado de baja." Enlace="/usuarios" TextoEnlace="Volver a usuarios" />
}
else
{
    <section class="card delete-preview">
        <span class="empty-icon @(usuario.Activo ? "danger" : "warning")">
            <Icono Nombre="@(usuario.Activo ? "eliminar" : "check")" Tamano="30" />
        </span>

        <h2>@(usuario.Activo ? "¿Desactivar esta cuenta?" : "¿Reactivar esta cuenta?")</h2>
        <p>Revisa los datos del usuario antes de continuar.</p>

        <div class="delete-person">
            <span class="avatar">@usuario.Iniciales</span>
            <div>
                <strong>@usuario.NombreCompleto</strong>
                <small>@@@usuario.Username · @usuario.Email · @usuario.Rol</small>
            </div>
        </div>

        <div class="alert alert-light border text-start small my-3">
            @if (usuario.Activo)
            {
                <span>
                    <strong>Baja lógica segura:</strong> Al desactivar la cuenta, el usuario perderá el acceso a la plataforma.
                    No se eliminará físicamente ningún registro, por lo que el histórico de cirugías, cotizaciones y auditoría
                    seguirá completamente intacto.
                </span>
            }
            else
            {
                <span>
                    <strong>Reactivación de acceso:</strong> Al reactivar la cuenta, el usuario volverá a tener acceso a las funciones
                    correspondientes a su rol (@usuario.Rol).
                </span>
            }
        </div>

        <div class="d-flex justify-content-center flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="@($"/usuarios/{Id}?rol={usuario.Rol}")">Cancelar</a>
            <button class="btn @(usuario.Activo ? "btn-danger" : "btn-success")"
                    type="button" disabled="@procesando" @onclick="ConfirmarAccionAsync">
                @if (procesando)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Procesando...</span>
                }
                else
                {
                    <Icono Nombre="@(usuario.Activo ? "eliminar" : "check")" Tamano="17" />
                    <span>@(usuario.Activo ? "Confirmar desactivación" : "Confirmar reactivación")</span>
                }
            </button>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public string? Rol { get; set; }

    private UsuarioDTO? usuario;
    private bool cargando = true;
    private bool procesando = false;
    private string? errorMensaje;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        errorMensaje = null;
        try
        {
            usuario = await UsuarioService.ObtenerPorIdAsync(Id, Rol);
        }
        catch (Exception ex)
        {
            errorMensaje = "Error al consultar usuario: " + MensajeDeError.Texto(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ConfirmarAccionAsync()
    {
        if (usuario is null) return;
        procesando = true;
        errorMensaje = null;
        try
        {
            if (usuario.Activo)
            {
                await UsuarioService.EliminarAsync(usuario.Id, usuario.Rol);
            }
            else
            {
                await UsuarioService.ReactivarAsync(usuario.Id, usuario.Rol);
            }
            Navigation.NavigateTo("/usuarios");
        }
        catch (ServicioException ex)
        {
            errorMensaje = MensajeDeError.Texto(ex);
        }
        catch (Exception ex)
        {
            errorMensaje = "Error al procesar la solicitud: " + MensajeDeError.Texto(ex);
        }
        finally
        {
            procesando = false;
        }
    }
}
