@page "/usuarios/nuevo"
@page "/usuarios/editar/{Id:int}"
@inject IUsuarioService UsuarioService
@inject NavigationManager Navigation

<PageTitle>@(Id.HasValue ? "Editar usuario" : "Nuevo usuario") | Klam</PageTitle>
<div class="breadcrumb-line">
    <a href="/usuarios">Usuarios</a><span>/</span>@(Id.HasValue ? "Editar usuario" : "Nuevo usuario")
</div>

<PageHeader Titulo="@(Id.HasValue ? "Editar usuario" : "Nuevo usuario")"
            Subtitulo="Completa los datos de la cuenta y su perfil de acceso.">
    <a class="btn btn-outline-secondary" href="/usuarios">
        <Icono Nombre="volver" Tamano="17" /> Volver al listado
    </a>
</PageHeader>

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <Icono Nombre="alerta" Tamano="20" Clase="me-2" />
        <div>@errorMensaje</div>
    </div>
}

@if (!string.IsNullOrEmpty(exitoMensaje))
{
    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
        <Icono Nombre="check" Tamano="20" Clase="me-2" />
        <div>@exitoMensaje</div>
    </div>
}

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando usuario...</span>
        </div>
        <p class="text-muted mt-2">Cargando datos del usuario...</p>
    </div>
}
else if (Id.HasValue && !usuarioExiste)
{
    <EstadoVacio Enlace="/usuarios" TextoEnlace="Volver a usuarios" Mensaje="No se encontró el usuario a editar." />
}
else
{
    <form @onsubmit="GuardarUsuarioAsync" @onsubmit:preventDefault>
        <div class="row g-4">
            <div class="col-lg-8">
                <section class="card mb-4">
                    <div class="section-heading">
                        <h2><Icono Nombre="usuarios" Tamano="18" /> Datos personales</h2>
                        <span>01</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <CampoForm Etiqueta="Nombres" Para="nombres">
                                <input class="form-control" id="nombres" @bind="modelo.Nombres" placeholder="Ej. Valeria" required />
                            </CampoForm>
                            <CampoForm Etiqueta="Apellidos" Para="apellidos">
                                <input class="form-control" id="apellidos" @bind="modelo.Apellidos" placeholder="Ej. Torres" required />
                            </CampoForm>
                            <CampoForm Etiqueta="Nombre de usuario" Para="username">
                                <div class="input-group">
                                    <span class="input-group-text">@@</span>
                                    <input class="form-control" id="username" @bind="modelo.Username" placeholder="Ej. vtorres"
                                           disabled="@Id.HasValue" required />
                                </div>
                            </CampoForm>
                            <CampoForm Etiqueta="Correo electrónico" Para="email">
                                <input class="form-control" id="email" type="email" @bind="modelo.Email" placeholder="nombre@empresa.com" required />
                            </CampoForm>
                        </div>
                    </div>
                </section>

                <section class="card">
                    <div class="section-heading">
                        <h2><Icono Nombre="escudo" Tamano="18" /> Acceso y responsabilidades</h2>
                        <span>02</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <CampoForm Etiqueta="Rol del personal" Para="usuario-rol">
                                <select id="usuario-rol" class="form-select" @bind="modelo.Rol">
                                    <option value="Administrador">Administrador</option>
                                    <option value="Vendedor">Vendedor</option>
                                    <option value="Instrumentista">Instrumentista</option>
                                </select>
                            </CampoForm>
                            <CampoForm Etiqueta="Estado de la cuenta" Para="usuario-estado">
                                <select id="usuario-estado" class="form-select" value="@(modelo.Activo ? "Activo" : "Inactivo")"
                                        @onchange="OnEstadoChanged">
                                    <option value="Activo">Activo</option>
                                    <option value="Inactivo">Inactivo</option>
                                </select>
                            </CampoForm>
                            @if (modelo.Rol == "Instrumentista" || modelo.Rol == "TECNICO_INSTRUMENTISTA")
                            {
                                <CampoForm Etiqueta="Especialidad quirúrgica" Para="usuario-especialidad" Columnas="col-12">
                                    <input id="usuario-especialidad" class="form-control" @bind="modelo.Especialidad"
                                           placeholder="Ej. Cirugía de columna, Neurocirugía, Artroscopia" />
                                </CampoForm>
                            }
                            <CampoForm Etiqueta="@(Id.HasValue ? "Nueva contraseña (opcional)" : "Contraseña")" Para="usuario-clave">
                                <input id="usuario-clave" class="form-control" type="password" @bind="modelo.Password"
                                       placeholder="@(Id.HasValue ? "Dejar en blanco para conservar la actual" : "Mínimo 8 caracteres, letra y número")"
                                       autocomplete="new-password" />
                            </CampoForm>
                            <CampoForm Etiqueta="Confirmar contraseña" Para="usuario-confirmacion">
                                <input id="usuario-confirmacion" class="form-control" type="password" @bind="passwordConfirmacion"
                                       placeholder="Repite la contraseña" autocomplete="new-password" />
                            </CampoForm>
                        </div>
                        <p class="field-help mt-3 mb-0">
                            La contraseña debe tener entre 8 y 64 caracteres, al menos una letra y un número, sin espacios.
                        </p>
                    </div>
                </section>

                <div class="form-actions mt-4">
                    <a class="btn btn-outline-secondary" href="/usuarios">Cancelar</a>
                    <button class="btn btn-primary" type="submit" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <Icono Nombre="check" Tamano="17" />
                            <span>@(Id.HasValue ? "Guardar cambios" : "Registrar usuario")</span>
                        }
                    </button>
                </div>
            </div>

            <div class="col-lg-4">
                <aside class="card profile-summary">
                    <span class="stat-icon"><Icono Nombre="escudo" Tamano="24" /></span>
                    <span class="eyebrow text-teal mt-3">PERFIL SELECCIONADO</span>
                    <h2>@modelo.Rol</h2>
                    <p>@DescripcionRol</p>
                    <hr />
                    <h3>Responsabilidad en BIOKLAM</h3>
                    <p>@DetallePermisosRol</p>
                </aside>
            </div>
        </div>
    </form>
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public string? Rol { get; set; }

    private UsuarioFormDTO modelo = new() { Rol = "Vendedor", Activo = true };
    private string passwordConfirmacion = "";
    private bool cargando = false;
    private bool usuarioExiste = true;
    private bool guardando = false;
    private string? errorMensaje;
    private string? exitoMensaje;

    private string DescripcionRol => modelo.Rol switch
    {
        "Administrador" => "Gestión de usuarios, revisión de solicitudes y coordinación de la agenda.",
        "Instrumentista" or "TECNICO_INSTRUMENTISTA" => "Consulta del calendario, verificación de equipos y aviso de cirugías asignadas.",
        _ => "Registro comercial de solicitudes y seguimiento de la programación de clientes."
    };

    private string DetallePermisosRol => modelo.Rol switch
    {
        "Administrador" => "Acceso total a usuarios, cirugías, inventario, bitácora documental y reportes de consumo.",
        "Instrumentista" or "TECNICO_INSTRUMENTISTA" => "Acceso a la agenda quirúrgica asignada y notificaciones internas.",
        _ => "Acceso a gestión comercial de clientes, registro de solicitudes y documentos de cotización."
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue)
        {
            cargando = true;
            try
            {
                var u = await UsuarioService.ObtenerPorIdAsync(Id.Value, Rol);
                if (u != null)
                {
                    modelo = new UsuarioFormDTO
                    {
                        Id = u.Id,
                        Nombres = u.Nombres,
                        Apellidos = u.Apellidos,
                        Username = u.Username,
                        Email = u.Email,
                        Rol = u.Rol,
                        Activo = u.Activo,
                        Especialidad = u.Especialidad,
                        ComisionAcumulada = u.ComisionAcumulada
                    };
                    usuarioExiste = true;
                }
                else
                {
                    usuarioExiste = false;
                }
            }
            catch (Exception ex)
            {
                errorMensaje = "Error al cargar usuario: " + ex.Message;
                usuarioExiste = false;
            }
            finally
            {
                cargando = false;
            }
        }
        else
        {
            modelo = new UsuarioFormDTO { Rol = "Vendedor", Activo = true };
            usuarioExiste = true;
        }
    }

    private void OnEstadoChanged(ChangeEventArgs e)
    {
        modelo.Activo = e.Value?.ToString() == "Activo";
    }

    private async Task GuardarUsuarioAsync()
    {
        errorMensaje = null;
        exitoMensaje = null;

        // Validaciones locales
        if (string.IsNullOrWhiteSpace(modelo.Nombres) || string.IsNullOrWhiteSpace(modelo.Apellidos))
        {
            errorMensaje = "Nombres y apellidos son obligatorios.";
            return;
        }
        if (string.IsNullOrWhiteSpace(modelo.Username))
        {
            errorMensaje = "El nombre de usuario es obligatorio.";
            return;
        }
        if (string.IsNullOrWhiteSpace(modelo.Email))
        {
            errorMensaje = "El correo electrónico es obligatorio.";
            return;
        }

        // Validación de contraseña
        if (!Id.HasValue)
        {
            if (string.IsNullOrWhiteSpace(modelo.Password))
            {
                errorMensaje = "La contraseña es obligatoria para nuevos usuarios.";
                return;
            }
            if (modelo.Password != passwordConfirmacion)
            {
                errorMensaje = "Las contraseñas no coinciden.";
                return;
            }
        }
        else if (!string.IsNullOrWhiteSpace(modelo.Password))
        {
            if (modelo.Password != passwordConfirmacion)
            {
                errorMensaje = "Las contraseñas no coinciden.";
                return;
            }
        }

        guardando = true;
        try
        {
            if (Id.HasValue)
            {
                await UsuarioService.ModificarAsync(Id.Value, modelo, Rol);
                exitoMensaje = "Usuario actualizado correctamente.";
            }
            else
            {
                await UsuarioService.CrearAsync(modelo);
                exitoMensaje = "Usuario registrado correctamente.";
            }

            // Esperar un breve instante y redirigir
            await Task.Delay(800);
            Navigation.NavigateTo("/usuarios");
        }
        catch (ServicioException ex)
        {
            errorMensaje = ex.Message;
        }
        catch (Exception ex)
        {
            errorMensaje = "Error al guardar usuario: " + ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}
