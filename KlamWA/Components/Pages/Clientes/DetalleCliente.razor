@page "/clientes/{Tipo}/{Id:int}"
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@using Microsoft.AspNetCore.Authorization
@using KlamWA.Components.Shared
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject IGestionClienteService Api

<PageTitle>Detalle de cliente</PageTitle>
@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
    <a href="/clientes">Volver a la lista</a>
}
else if (c is null)
{
    <p class="text-muted">Cargando cliente…</p>
}
else
{
    bool particular = c.TipoCliente == "PACIENTE_PARTICULAR";
    <PageHeader Titulo="@c.Nombre" Subtitulo="@("Cliente #" + c.IdCliente + " · " + (particular ? DatosClientes.Particular : DatosClientes.Clinica))">
        <span class="badge @(c.Activo ? "text-bg-success" : "text-bg-secondary") align-self-center">@(c.Activo ? "Activo" : "Inactivo")</span>
        <a class="btn btn-primary" href="/clientes/editar/@c.TipoCliente/@c.IdCliente">Editar</a>
        <a class="btn btn-outline-dark" href="/clientes">Volver</a>
    </PageHeader>
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header">Datos del cliente</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">@(particular ? "DNI" : "RUC")</dt>
                        <dd class="col-sm-8">@(particular ? c.Dni : c.Ruc)</dd>
                        <dt class="col-sm-4">Dirección</dt><dd class="col-sm-8">@c.Direccion</dd>
                        <dt class="col-sm-4">Correo de contacto</dt><dd class="col-sm-8">@c.EmailContacto</dd>
                        <dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">@c.Telefono</dd>
                        @if (particular)
                        {
                            <dt class="col-sm-4">Pago confirmado</dt><dd class="col-sm-8">@(c.PagoConfirmado ? "Sí" : "No")</dd>
                        }
                        else
                        {
                            <dt class="col-sm-4">Consignación</dt><dd class="col-sm-8">@(c.TieneConsignacion ? "Sí" : "No")</dd>
                            <dt class="col-sm-4">Periodo de crédito</dt><dd class="col-sm-8">@c.PeriodoCredito</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">Acciones y enlaces</div>
                <div class="list-group list-group-flush">
                    <a class="list-group-item list-group-item-action" href="/solicitudes">Ver solicitudes y documentación</a>
                    <a class="list-group-item list-group-item-action" href="/agenda/historial">Ver historial de cirugías</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Tipo { get; set; } = "";
    [Parameter] public int Id { get; set; }

    private ClienteFormDTO? c;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        c = null; error = null;
        try { c = await Api.ObtenerAsync(Tipo, Id); }
        catch (ServicioException ex) { error = ex.Message; }
    }
}
