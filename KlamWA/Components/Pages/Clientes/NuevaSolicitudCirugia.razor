@page "/mis-solicitudes/nueva"
@using KlamWA.Components.Shared
@using KlamWA.ViewModels

<PageTitle>Nueva solicitud de cirugía</PageTitle>

<PageHeader Titulo="Solicitar cirugía" Subtitulo="Cliente o vendedor · Formulario visual sin envío" />

<EditForm Model="ViewModel">



    <div class="card mb-3" style="max-width:900px">
        <div class="card-header">Datos de la cirugía</div>
        <div class="card-body">
            <div class="row g-3">
                <CampoForm Etiqueta="Clínica u hospital donde se realizará" Columnas="col-12">
                    <InputSelect class="form-select" @bind-Value="ViewModel.IdClinica">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var x in DatosClientes.Clinicas) { <option value="@x.Key">@x.Value</option> }
                    </InputSelect>
                </CampoForm>
                <CampoForm Etiqueta="Diagnóstico" Columnas="col-12">
                    <InputTextArea class="form-control" rows="2" @bind-Value="ViewModel.Diagnostico" />
                </CampoForm>
                <CampoForm Etiqueta="Procedimiento">
                    <InputText class="form-control" @bind-Value="ViewModel.Procedimiento" />
                </CampoForm>
                <CampoForm Etiqueta="Médico">
                    <InputText class="form-control" @bind-Value="ViewModel.Medico" />
                </CampoForm>
                <CampoForm Etiqueta="Fecha">
                    <InputDate Type="InputDateType.Date" class="form-control" @bind-Value="ViewModel.Fecha" />
                </CampoForm>
                <CampoForm Etiqueta="Hora">
                    <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="ViewModel.Hora" />
                </CampoForm>
                <CampoForm Etiqueta="Observaciones (opcional)" Columnas="col-12">
                    <InputTextArea class="form-control" rows="2" @bind-Value="ViewModel.Observaciones" />
                </CampoForm>
            </div>
        </div>
    </div>

    <div class="card mb-3" style="max-width:900px">
        <div class="card-header">Documentos adjuntos</div>
        <div class="card-body">
            <p class="text-muted small">Vista de ejemplo: en este laboratorio los archivos no se suben. La orden de compra de clínicas se adjunta cuando la cirugía está culminada, desde el detalle o la lista de cirugías.</p>
            @foreach (var tipo in DatosClientes.TiposDocumentoSolicitud)
            {
                <div class="row g-2 align-items-center mb-2">
                    <div class="col-md-3">
                        @tipo
                        @if (tipo == DatosClientes.ComprobantePago)
                        {
                            <div class="small text-muted">Para clientes particulares</div>
                        }
                    </div>
                    <div class="col-md-6"><input type="file" class="form-control form-control-sm" /></div>
                    <div class="col-md-3"><DocumentoEstadoBadge Estado="Pendiente" /></div>
                </div>
            }
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-primary" disabled>Enviar solicitud</button>
            <a class="btn btn-outline-secondary" href="/mis-solicitudes">Cancelar</a>
        </div>
    </div>
</EditForm>

@code {
    private SolicitudCirugiaViewModel ViewModel { get; set; } = new();
}
