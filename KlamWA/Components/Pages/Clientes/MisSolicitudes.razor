@page "/mis-solicitudes"
@using System.Net
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject VistaPreviaRol Vista
@inject ISolicitudCirugiaService Solicitudes

<PageTitle>Solicitudes de cirugía</PageTitle>
<PageHeader Titulo="Solicitudes de cirugía" Subtitulo="Solicitudes registradas por el vendedor">
    @if (Vista.Perfil.Clave == "vendedor") { <a class="btn btn-primary" href="/mis-solicitudes/nueva">Nueva solicitud</a> }
</PageHeader>

@if (Vista.Perfil.Clave != "vendedor")
{
    <div class="alert alert-warning">Esta consulta está disponible para el vendedor.</div>
}
else if (cargando)
{
    <div class="text-muted">Cargando solicitudes...</div>
}
else if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
else if (solicitudes.Count == 0)
{
    <div class="alert alert-info">Aún no ha registrado solicitudes de cirugía.</div>
}
else
{
    <div class="table-responsive"><table class="table table-hover align-middle">
        <thead class="table-light"><tr><th>N.º</th><th>Fecha solicitada</th><th>Cliente</th><th>Clínica</th><th>Procedimiento</th><th>Médico</th><th>Estado</th><th class="acciones">Acciones</th></tr></thead>
        <tbody>
        @foreach (var s in solicitudes)
        {
            <tr>
                <td class="fw-semibold text-nowrap">@s.Codigo</td><td>@s.FechaHoraSolicitada.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@s.Cliente</td><td>@s.ClinicaDestino</td><td>@s.TipoProcedimiento</td><td>@s.DoctorNombre</td>
                <td><DocumentoEstadoBadge Estado="@s.Estado" /></td>
                <td class="acciones"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Alternar(s.IdSolicitud)">@(abierta == s.IdSolicitud ? "Ocultar detalle" : "Ver detalle")</button><a class="btn btn-sm btn-primary ms-1" href="/mis-solicitudes/@s.IdSolicitud/documentos">Documentos</a></td>
            </tr>
            @if (abierta == s.IdSolicitud)
            {
                <tr><td colspan="8" class="bg-light"><div class="p-2"><div><strong>Paciente:</strong> @s.PacienteNombre</div><div><strong>Diagnóstico:</strong> @s.Diagnostico</div>
                    @if (!string.IsNullOrWhiteSpace(s.MotivoRechazo)) { <div class="alert alert-danger py-2 mt-2 mb-0"><strong>Motivo de rechazo:</strong> @s.MotivoRechazo</div> }
                </div></td></tr>
            }
        }
        </tbody>
    </table></div>
}

@code {
    private List<SolicitudCirugiaDTO> solicitudes = [];
    private int abierta;
    private bool cargando = true;
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        if (Vista.Perfil.Clave != "vendedor") { cargando = false; return; }
        try { solicitudes = await Solicitudes.ListarMiasAsync(); }
        catch (HttpRequestException ex) {
            error = ex.StatusCode switch {
                HttpStatusCode.Unauthorized => "La sesión expiró. Vuelva a iniciar sesión.",
                HttpStatusCode.Forbidden => "No tiene permiso para consultar estas solicitudes.",
                HttpStatusCode.NotFound => "El servicio de solicitudes no está disponible.",
                HttpStatusCode.BadRequest or HttpStatusCode.Conflict => ex.Message,
                _ => "No se pudieron cargar las solicitudes: " + ex.Message
            };
        }
        finally { cargando = false; }
    }
    private void Alternar(int id) => abierta = abierta == id ? 0 : id;
}
