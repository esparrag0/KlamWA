@page "/clientes"
@using KlamWA.Components.Shared
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject IGestionClienteService Api

<PageTitle>Clientes</PageTitle>

@* «Solicitudes de cirugía» llevaba a /mis-solicitudes, que es la bandeja del
   vendedor, no de clientes. Esta pantalla solo necesita su propia acción. *@
<PageHeader Titulo="Clientes" Subtitulo="Pacientes particulares y clínicas/hospitales">
    <a class="btn btn-primary" href="/clientes/nuevo"><Icono Nombre="mas" Tamano="17" /> Nuevo cliente</a>
</PageHeader>

@* Esta barra era decorativa: ningún control estaba enlazado y el botón no
   hacía nada. Ahora filtra de verdad, sobre la lista ya cargada. *@
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small mb-1" for="buscar-cliente">Buscar</label>
                <input id="buscar-cliente" type="text" class="form-control form-control-sm" list="lista-clientes-gestion"
                       autocomplete="off" placeholder="Nombre, DNI o RUC"
                       @bind="busqueda" @bind:event="oninput" />
                <datalist id="lista-clientes-gestion">
                    @foreach (var sugerencia in Sugerencias) { <option value="@sugerencia"></option> }
                </datalist>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="tipo-cliente">Tipo de cliente</label>
                <select id="tipo-cliente" class="form-select form-select-sm" @bind="filtroTipo">
                    <option value="">Todos</option>
                    <option value="PACIENTE_PARTICULAR">@DatosClientes.Particular</option>
                    <option value="CLINICA_HOSPITAL">@DatosClientes.Clinica</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1" for="estado-cliente">Estado</label>
                <select id="estado-cliente" class="form-select form-select-sm" @bind="filtroEstado">
                    <option value="">Todos</option>
                    <option value="activo">Activo</option>
                    <option value="inactivo">Inactivo</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LimpiarFiltros">Limpiar</button>
            </div>
        </div>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Documento</th>
                <th>Contacto</th>
                <th>Estado</th>
                <th class="acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Filtrados)
            {
                <tr>
                    <td>@c.Nombre</td>
                    <td>
                        <span class="badge @(c.TipoCliente == "PACIENTE_PARTICULAR" ? "text-bg-info" : "text-bg-primary")">@(c.TipoCliente == "PACIENTE_PARTICULAR" ? DatosClientes.Particular : DatosClientes.Clinica)</span>
                    </td>
                    <td>@c.Documento</td>
                    <td>
                        <div>@c.EmailContacto</div>
                        <small class="text-muted">@c.Telefono</small>
                    </td>
                    <td>
                        <span class="badge @(c.Activo ? "text-bg-success" : "text-bg-secondary")">@(c.Activo ? "Activo" : "Inactivo")</span>
                    </td>
                    <td class="acciones">
                        <a class="btn btn-sm btn-outline-primary" href="/clientes/@c.TipoCliente/@c.IdCliente">Ver detalle</a>
                        <a class="btn btn-sm btn-outline-secondary" href="/clientes/editar/@c.TipoCliente/@c.IdCliente">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<ClienteGestionDTO> clientes = [];
    private string? error;
    private string busqueda = "";
    private string filtroTipo = "";
    private string filtroEstado = "";

    private IEnumerable<string> Sugerencias =>
        clientes.Select(c => c.Nombre)
            .Concat(clientes.Select(c => c.Documento))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order();

    private IEnumerable<ClienteGestionDTO> Filtrados => clientes.Where(c =>
        (filtroTipo == "" || c.TipoCliente == filtroTipo)
        && (filtroEstado == "" || (filtroEstado == "activo") == c.Activo)
        && (string.IsNullOrWhiteSpace(busqueda)
            || c.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
            || c.Documento.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
            || (c.EmailContacto ?? "").Contains(busqueda, StringComparison.OrdinalIgnoreCase)));

    private void LimpiarFiltros()
    {
        busqueda = filtroTipo = filtroEstado = "";
    }

    protected override async Task OnInitializedAsync()
    {
        try { clientes = await Api.ListarAsync(); }
        catch (HttpRequestException ex) { error = MensajeDeError.Texto(ex); }
    }
}
