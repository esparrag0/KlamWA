@page "/clientes"
@using KlamWA.Components.Shared
@using KlamWA.DTOs
@using KlamWA.Servicios
@inject IGestionClienteService Api

<PageTitle>Clientes</PageTitle>

<PageHeader Titulo="Clientes" Subtitulo="Pacientes particulares y clínicas/hospitales">
    <a class="btn btn-outline-secondary" href="/mis-solicitudes">Solicitudes de cirugía</a>
    <a class="btn btn-primary" href="/clientes/nuevo">Nuevo cliente</a>
</PageHeader>

@* Barra de filtros solo visual (Lab 9: no filtra datos) *@
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small mb-1">Buscar</label>
                <input type="text" class="form-control form-control-sm" placeholder="Nombre, DNI o RUC" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Tipo de cliente</label>
                <select class="form-select form-select-sm">
                    <option>Todos</option>
                    <option>@DatosClientes.Particular</option>
                    <option>@DatosClientes.Clinica</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Estado</label>
                <select class="form-select form-select-sm">
                    <option>Todos</option>
                    <option>Activo</option>
                    <option>Inactivo</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="button" class="btn btn-secondary btn-sm">Filtrar</button>
            </div>
        </div>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Documento</th>
                <th>Contacto</th>
                <th>Estado</th>
                <th class="acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in clientes)
            {
                <tr>
                    <td>@c.Nombre</td>
                    <td>
                        <span class="badge @(c.TipoCliente == "PACIENTE_PARTICULAR" ? "text-bg-info" : "text-bg-primary")">@(c.TipoCliente == "PACIENTE_PARTICULAR" ? DatosClientes.Particular : DatosClientes.Clinica)</span>
                    </td>
                    <td>@c.Documento</td>
                    <td>
                        <div>@c.EmailContacto</div>
                        <small class="text-muted">@c.Telefono</small>
                    </td>
                    <td>
                        <span class="badge @(c.Activo ? "text-bg-success" : "text-bg-secondary")">@(c.Activo ? "Activo" : "Inactivo")</span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/clientes/@c.TipoCliente/@c.IdCliente">Ver detalle</a>
                        <a class="btn btn-sm btn-outline-secondary" href="/clientes/editar/@c.TipoCliente/@c.IdCliente">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<ClienteGestionDTO> clientes = [];
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { clientes = await Api.ListarAsync(); }
        catch (HttpRequestException ex) { error = ex.Message; }
    }
}
